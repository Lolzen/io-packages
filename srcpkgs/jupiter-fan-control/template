# Template file for 'jupiter-fan-control'
pkgname=jupiter-fan-control
version=20260902.1
revision=5
_pkgrel=1
wrksrc="${pkgname}"
python_version=3
depends="python3 python3-yaml"
hostmakedepends="git tar"
short_desc="Jupiter fan controller for Steam Deck"
maintainer="Georg <funer@gmx.at>"
license="MIT"
homepage="https://gitlab.steamos.cloud/jupiter/jupiter-fan-control"
distfiles="https://steamdeck-packages.steamos.cloud/archlinux-mirror/sources/jupiter-main/${pkgname}-${version}-${_pkgrel}.src.tar.gz"
checksum=ccc3bcf34f6ad5a1cdb2c1c8e94d6c9251d82532888523f57127ea0b62868a77

post_extract() {
	git --git-dir=jupiter-fan-control archive --format=tar "${version}" | tar -x
}

do_install() {
	vmkdir usr/share/jupiter-fan-control
	vinstall usr/share/jupiter-fan-control/fancontrol.py 755 usr/share/jupiter-fan-control
	vinstall usr/share/jupiter-fan-control/jupiter-config.yaml 644 usr/share/jupiter-fan-control
	vinstall usr/share/jupiter-fan-control/galileo-config.yaml 644 usr/share/jupiter-fan-control
	vinstall usr/share/jupiter-fan-control/fremont-config.yaml 644 usr/share/jupiter-fan-control
	# vsv adds the supervise link and a log service (vlogger), as for every
	# other Io service.
	vsv jupiter-fan-control
}