#!/usr/bin/python3
"""io-volumed: setzt die Systemlautstaerke bei Druck auf die
Gehaeusetasten des Steam Deck. Steam zeigt das OSD, aendert aber
den Pegel nicht selbst, weil es dafuer steamos-manager erwartet."""
import subprocess
import sys

import libevdev

STEP = "5%"
SINK = "@DEFAULT_AUDIO_SINK@"


def find_keyboard():
    for n in range(32):
        path = f"/dev/input/event{n}"
        try:
            fd = open(path, "rb")
        except (FileNotFoundError, PermissionError):
            continue
        dev = libevdev.Device(fd)
        if dev.name == "AT Translated Set 2 keyboard" and dev.has(
            libevdev.EV_KEY.KEY_VOLUMEUP
        ):
            return dev
        fd.close()
    return None


def set_volume(arg):
    subprocess.run(
        ["wpctl", "set-volume", "-l", "1.0", SINK, arg],
        check=False,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )


def main():
    dev = find_keyboard()
    if dev is None:
        print("io-volumed: Tastaturgeraet nicht gefunden", file=sys.stderr)
        return 1
    print(f"io-volumed: lausche auf {dev.name}")

    for event in dev.events():
        if event.value != 1:
            continue
        if event.matches(libevdev.EV_KEY.KEY_VOLUMEUP):
            set_volume(f"{STEP}+")
        elif event.matches(libevdev.EV_KEY.KEY_VOLUMEDOWN):
            set_volume(f"{STEP}-")
        elif event.matches(libevdev.EV_KEY.KEY_MUTE):
            subprocess.run(
                ["wpctl", "set-mute", SINK, "toggle"],
                check=False,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
            )
    return 0


if __name__ == "__main__":
    sys.exit(main())