# Template file for 'steam-jupiter'
pkgname=steam-jupiter
version=1.0.0.85
revision=3
_bootstrap=steam_jupiter_stable_bootstrapped_20251031.0.tar.xz
wrksrc="steam-jupiter-stable"
hostmakedepends="tar"
provides="steam-${version}_1"
replaces="steam>=0"
depends="zenity xz curl dbus freetype gdk-pixbuf hicolor-icon-theme
 desktop-file-utils liberation-fonts-ttf file tar bash coreutils lsof
 steam-udev-rules usbutils xrandr python3 xdg-user-dirs nss libxcrypt
 glibc-32bit libgcc-32bit libstdc++-32bit libdrm-32bit libglvnd-32bit
 mesa-dri-32bit vulkan-loader-32bit libcurl-32bit libnm-32bit libva-32bit
 fontconfig-32bit libX11-32bit libXinerama-32bit libXScrnSaver-32bit
 alsa-plugins-32bit alsa-pipewire-32bit libgpg-error-32bit nss-32bit
 libxcrypt-32bit libpipewire-32bit"
short_desc="Valve's Steam Deck packaging of Steam: preinstalled client, Deck branch, udev rules"
maintainer="Georg <funer@gmx.at>"
license="custom:Proprietary"
homepage="https://store.steampowered.com/steamdeck"
distfiles="https://steamdeck-packages.steamos.cloud/archlinux-mirror/sources/jupiter-main/steam-jupiter-stable-${version}-12.src.tar.gz"
checksum=501192ec11ba049074d2883aa870c9e979082f7af8601934850f3f088a2aef27
nostrip=yes

# Valve's steam-jupiter-stable: replaces the plain steam package, as Valve's
# replaces Arch's. Dependencies are Void steam's own list plus what Valve's
# PKGBUILD adds (32-bit libraries, libnm for the Wi-Fi page of first-run
# setup), in Void's names; Controller udev rules keep coming from Void's
# steam-udev-rules.
#
# - Steam's launcher from Valve's source, moved to /usr/lib/steam/steam as
#   Valve does, with a fully bootstrapped client on the Deck's stable branch
#   next to it: Steam does not download itself on first start.
# - steam-jupiter: Valve's wrapper (sets the update branch to
#   steamdeck_stable, adds -steamdeck -pipewire). /usr/bin/steam points to
#   it, so every way of starting Steam goes through it.
# - udev rules for input devices, the status LED and wakeup by controllers.
do_install() {
	tar -xzf steam_${version}.tar.gz
	make -C steam-launcher DESTDIR=${DESTDIR} install

	mv ${DESTDIR}/usr/bin/steam ${DESTDIR}/usr/lib/steam/steam
	rm -f ${DESTDIR}/usr/lib/steam/bootstraplinux_ubuntu12_32.tar.xz
	vinstall ${_bootstrap} 644 usr/lib/steam bootstraplinux_ubuntu12_32.tar.xz

	vbin steam-jupiter.sh steam-jupiter
	ln -sf steam-jupiter ${DESTDIR}/usr/bin/steam
	ln -sf /usr/bin/true ${DESTDIR}/usr/bin/steamdeps

	vmkdir usr/lib/udev/rules.d
	vinstall 70-steam-jupiter-input.rules 644 usr/lib/udev/rules.d
	vinstall 70-steam-jupiter-leds.rules 644 usr/lib/udev/rules.d
	vinstall 99-power-wakeup.rules 644 usr/lib/udev/rules.d

	vlicense steam-launcher/steam_subscriber_agreement.txt LICENSE
}
