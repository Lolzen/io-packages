# Valve's ibus-anthy (jupiter-3.9 1.5.14-4.5, as on SteamOS 3.9.2): 1.5.14 plus
# six commits not upstream - page up/down and number keys in prediction mode,
# and the settings show-lut-on-convert and behavior-on-select-candidate, which
# Steam's on-screen keyboard writes for its "anthy" layout. They do not apply
# to Void's 1.5.16, so this is Valve's tree under its own name, replacing
# Void's ibus-anthy (an Io package of the same name would never be picked:
# xbps takes a package from the first repository that has it, and Void's
# repository comes first). Built against anthy-unicode as Void's ibus-anthy;
# Valve's uses the older anthy.

post_extract() {
	git --git-dir=ibus-anthy archive --format=tar ${_commit} | tar -x
}

pre_configure() {
	autoreconf -fi
}
