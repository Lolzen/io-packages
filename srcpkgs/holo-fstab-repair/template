# Template file for 'holo-fstab-repair'
pkgname=holo-fstab-repair
version=0.2
revision=2
short_desc="Disable invalid SD card fstab entries that block UDisks2"
maintainer="Georg <funer@gmx.at>"
license="LGPL-2.1-or-later"
homepage="https://steamdeck-packages.steamos.cloud/archlinux-mirror/sources/holo-main"

# files/holo-fstab-repair is Valve's script exactly as SteamOS 3.8.4
# installs it (holo-fstab-repair 0.1-1, /usr/lib/steamos). The version stays
# at 0.2, the archive this package was first made from, so updates keep
# working. A runit core-service stands in for the systemd unit.
do_install() {
	vmkdir usr/lib/steamos
	vinstall ${FILESDIR}/holo-fstab-repair 755 usr/lib/steamos
	vmkdir etc/runit/core-services
	vinstall ${FILESDIR}/20-fstab-repair.sh 644 etc/runit/core-services
}
