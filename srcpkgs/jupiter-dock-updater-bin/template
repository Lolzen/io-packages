# Template file for 'jupiter-dock-updater-bin'
pkgname=jupiter-dock-updater-bin
version=20260811.01
revision=1
_pkgrel=1
archs="x86_64"
wrksrc="${pkgname}"
hostmakedepends="git tar"
depends="bash"
short_desc="Steam Deck Dock firmware updater (Valve's prebuilt binaries)"
maintainer="Georg <funer@gmx.at>"
license="custom:Proprietary"
homepage="https://gitlab.steamos.cloud/jupiter/jupiter-dock-updater-bin"
distfiles="https://steamdeck-packages.steamos.cloud/archlinux-mirror/sources/jupiter-3.9/${pkgname}-${version}-${_pkgrel}.src.tar.gz"
checksum=ad15a70e80bab774d2c4c86431ae1bbb1ffd9ec784e87b7ad98d223cf38b4f7d
nostrip=yes

# Valve's package as it is (newest in jupiter-3.9): hub_update (Kinetic's
# flasher, needs libusb), the dock firmware images, update.ini and the
# wrapper jupiter-dock-updater.sh, which Steam reaches through
# steamos-polkit-helpers/jupiter-dock-updater (deck-hw-support), and
# steamos-manager runs for UpdateDock1 (platform.toml's [update_dock], which
# names this path). "--check" exits 0 when an update
# is available and 7 when the dock is up to date. Valve publishes the
# binaries in its source mirror without a licence that says whether others
# may redistribute them.

post_extract() {
	git --git-dir=jupiter-dock-updater-bin archive --format=tar "jupiter-${version}" | tar -x
}

do_install() {
	local d=packaged/usr/lib/jupiter-dock-updater f
	vmkdir usr/lib/jupiter-dock-updater
	for f in hub_update jupiter-dock-updater.sh jupiter-dock-updater-mock.sh; do
		vinstall $d/$f 755 usr/lib/jupiter-dock-updater
	done
	for f in $d/*.bin $d/update.ini; do
		vinstall "$f" 644 usr/lib/jupiter-dock-updater
	done
}
