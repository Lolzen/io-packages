<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>

  <vendor>Io</vendor>
  <vendor_url>https://github.com/Lolzen/io-packages</vendor_url>

  <action id="org.io.policykit.pkexec.run-io-priv-exec">
    <description>Helper to run a fixed set of whitelisted privileged actions</description>
    <icon_name>package-x-generic</icon_name>
    <defaults>
      <allow_any>yes</allow_any>
      <allow_inactive>yes</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/io-priv-exec</annotate>
  </action>

</policyconfig>