# Template file for 'holo-dmi-rules'
pkgname=holo-dmi-rules
version=1.1
revision=2
short_desc="Valve's DMI serial number permissions (dmi-product-serial.conf)"
maintainer="Georg <funer@gmx.at>"
license="LGPL-2.1-or-later"
homepage="https://gitlab.steamos.cloud/holo/holo"

# Valve's package is one tmpfiles.d file (product_serial and board_serial:
# 440 root:wheel); Void has no tmpfiles, so a core-service applies it at boot.
do_install() {
	vmkdir etc/runit/core-services
	vinstall ${FILESDIR}/20-dmi-serial-perms.sh 644 etc/runit/core-services
}