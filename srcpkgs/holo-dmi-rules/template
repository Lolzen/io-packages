checksum=788e62abe238577bf8118888dedca63c3b5143189e885747706c2e7d7f7e5522

do_install() {
	vmkdir etc/runit/core-services
	vinstall ${FILESDIR}/20-dmi-serial-perms.sh 755 etc/runit/core-services
}