<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Io</vendor>
  <vendor_url>https://github.com/Lolzen/io-packages</vendor_url>

  <!-- Steam runs steamos-reset-tool for its factory reset. SteamOS runs the
       tool's backends as root through a setuid wrapper (anyone may); Io
       allows the active local session (Steam) without a password, others
       (SSH, other seats) need an admin's, as for
       steamos-factory-reset-config. -->
  <action id="org.io.pkexec.steamos-reset-tool">
    <description>Run Steam's factory reset</description>
    <message>Authentication is required to reset the system</message>
    <defaults>
      <allow_any>auth_admin_keep</allow_any>
      <allow_inactive>auth_admin_keep</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/steamos-reset-tool</annotate>
  </action>
</policyconfig>
