# Template file for 'io-factory-reset'
pkgname=io-factory-reset
version=0.1.1
revision=1
depends="bash coreutils findutils util-linux shadow e2fsprogs xbps"
short_desc="Io's factory reset: user data, OS, or both (Steam's FactoryReset1)"
maintainer="Georg <funer@gmx.at>"
license="MIT"
homepage="https://github.com/Lolzen/io-packages"

# Io's own stand-in for SteamOS's steamos-reset (steamos-reset-tool) and
# holo-factory-reset, which reset an A/B system: SteamOS formats its /home
# and /var partitions at the next boot and installs a fresh OS image into
# the other slot. Io has one root filesystem, so it erases the user data
# file by file at the next boot (core service 04-io-factory-reset.sh) and
# resets the OS in place with xbps; what each covers is in io-factory-reset.
# Called by io-steamos-manager (FactoryReset1.PrepareFactoryReset) and by
# Steam's helper steamos-factory-reset-config (deck-hw-support). The
# image's own settings come from /var/lib/io/factory-defaults, written by
# mkrootfs.sh; installations made before fall back to the build defaults.
do_install() {
	vbin ${FILESDIR}/io-factory-reset
	vmkdir etc/runit/core-services
	vinstall ${FILESDIR}/04-io-factory-reset.sh 644 etc/runit/core-services
}
