# Template file for 'io-atomupd'
pkgname=io-atomupd
version=0.1.0
revision=2
python_version=3
depends="python3 python3-dbus-fast runit-void xbps"
short_desc="Atomupd1 system update service for Io (xbps behind Steam's update API)"
maintainer="Georg <funer@gmx.at>"
license="MIT"
homepage="https://github.com/Lolzen/io-packages"
# Until 0.18.1, io-steamos-manager's root half served Atomupd1 and shipped
# steamos-update and io-update; Valve's steamos-manager replaces the rest.
replaces="io-steamos-manager>=0"

do_install() {
	vbin ${FILESDIR}/io-atomupd.py io-atomupd
	vsv io-atomupd
	vinstall ${FILESDIR}/com.steampowered.Atomupd1.conf 644 usr/share/dbus-1/system.d
	# System updates from Steam with xbps: Steam's script interface and the
	# helper it shares with Atomupd1.
	vbin ${FILESDIR}/steamos-update
	vmkdir usr/libexec/io
	vinstall ${FILESDIR}/io-update 755 usr/libexec/io
}
