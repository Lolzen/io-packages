# Template file for 'deck-hw-support'
pkgname=deck-hw-support
version=20260807.1
revision=13
hostmakedepends="xcursorgen"
depends="polkit jq alsa-utils dmidecode elogind udisks2"
short_desc="Steam Deck hardware support helpers from jupiter-hw-support"
maintainer="Georg <funer@gmx.at>"
license="MIT"
homepage="https://gitlab.steamos.cloud/jupiter/jupiter-hw-support"

# Valve's changes from 20250728.1 to 20260807.1 are almost all renames
# (steamos-* helpers became holo-*, with steamos-alias linking the old names
# back). SteamOS 3.8.4 runs 20260327.1 with the steamos-* names, 3.9.2 runs
# 20260807.1 with steamos-alias's links; Steam and io-steamos-manager call
# the steamos-* names, so Io keeps them and takes only the actual changes: a
# sturdier jupiter-check-support and the restructured GPU reset rules. Valve's cursor theme (the images come from 20260327.1:
# later versions moved them to a holo package) is new in Io.
#
# Automount of SD cards and USB drives as on SteamOS: Valve's udev rule and
# scripts (udisks mounts ext4 under /run/media/deck/<label>), started through
# io-detach instead of systemd-run, and leaving out the disk Io runs from.
# trim-devices.sh does not fall back to trimming /var and /home on a card
# that is unsafe to trim: on Io they may be on that card.
# While Io runs from the SD card, the internal SSD (SteamOS) is hidden from
# udisks, so neither Steam nor Plasma offers it (90-io-hide-internal-disk).

do_install() {
	vmkdir usr/bin/steamos-polkit-helpers
	for f in ${FILESDIR}/steamos-polkit-helpers/*; do
		vinstall "$f" 755 usr/bin/steamos-polkit-helpers
	done

	vmkdir usr/lib/hwsupport
	for f in ${FILESDIR}/hwsupport/*; do
		vinstall "$f" 755 usr/lib/hwsupport
	done

	vmkdir usr/lib/udev/rules.d
	for f in ${FILESDIR}/udev/rules.d/*; do
		vinstall "$f" 644 usr/lib/udev/rules.d
	done

	vmkdir usr/share/polkit-1/actions
	vinstall ${FILESDIR}/polkit-1/actions/org.valve.steamos.policy 644 usr/share/polkit-1/actions

	vmkdir usr/share/polkit-1/rules.d
	vinstall ${FILESDIR}/polkit-1/rules.d/org.valve.steamos.rules 644 usr/share/polkit-1/rules.d

	# /usr/bin/steamos-update is the real script (io-steamos-manager); the
	# helper above re-runs itself through pkexec and calls it, as Valve's.
	for f in steamos-select-branch jupiter-biosupdate; do
		ln -sf steamos-polkit-helpers/$f ${DESTDIR}/usr/bin/$f
	done

	vbin ${FILESDIR}/bin/jupiter-check-support
	# Steam asks it whether a "day one firmware update" screen is needed. Only
	# Galileo units ever need one; on Jupiter Valve's script exits 0 at once.
	vbin ${FILESDIR}/bin/jupiter-initial-firmware-update

	# Valve's cursor theme "steam", built from its images as Valve's
	# PKGBUILD does (XCURSOR_THEME=steam in the game mode session).
	vmkdir usr/share/steamos
	cp -a ${FILESDIR}/cursor/steamos/. ${DESTDIR}/usr/share/steamos/
	vmkdir usr/share/icons/steam/cursors
	cp -a ${FILESDIR}/cursor/icons-steam/. ${DESTDIR}/usr/share/icons/steam/
	cd ${DESTDIR}/usr/share/steamos
	xcursorgen steamos-cursor-config ${DESTDIR}/usr/share/icons/steam/cursors/default
}
