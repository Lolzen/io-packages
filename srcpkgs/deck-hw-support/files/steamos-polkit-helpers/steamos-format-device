#!/bin/bash
# Valve's helper (holo-format-device in jupiter-hw-support 20260807.1, here
# under its steamos-* name, which Steam calls). format-device.sh refuses the
# disk Io runs from.

set -eu

if [[ $EUID -ne 0 ]];
then
    gid="$(id -g "$UID")"
    exec pkexec --disable-internal-agent "$0" --owner "$UID":"$gid" "$@"
fi

exec /usr/lib/hwsupport/format-device.sh "$@"
