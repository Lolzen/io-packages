#!/bin/bash
# Valve's helper (jupiter-hw-support 20260807.1): runs Valve's dock updater
# (jupiter-dock-updater-bin, hub_update) for the Steam Deck Docking Station.
# Exit codes are hub_update's: with --check, 0 = update available,
# 7 = up to date.

set -eu

if [[ $EUID -ne 0 ]];
then
    exec pkexec --disable-internal-agent "$0" "$@"
fi

# Io: without jupiter-dock-updater-bin, answer "up to date" to a check (a 0
# would make Steam announce a dock update at every start) and refuse an
# update.
if [[ ! -x /usr/lib/jupiter-dock-updater/jupiter-dock-updater.sh ]]; then
    [[ ${1:-} = --check ]] && exit 7
    echo "No dock updater installed" >&2
    exit 1
fi

exec /usr/lib/jupiter-dock-updater/jupiter-dock-updater.sh "$@"
