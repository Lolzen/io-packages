# Work around the misdetection of some SanDisk microSD cards
# Io: io-detach instead of systemd-run (no systemd). Left out while Io runs
# from an SD card: the rescan rebinds the card reader, which would take the
# running system's disk away (a misdetected boot card never gets this far
# anyway). With Io on the internal SSD it works as on SteamOS.

ACTION!="add", GOTO="sdcard_rescan_end"
SUBSYSTEM!="mmc", GOTO="sdcard_rescan_end"
ENV{MMC_NAME}!="SD032", GOTO="sdcard_rescan_end"
PROGRAM="/usr/lib/hwsupport/io-root-disk", RESULT=="mmcblk*", GOTO="sdcard_rescan_end"
RUN+="/usr/lib/hwsupport/io-detach /usr/lib/hwsupport/sdcard-rescan.sh %k"

LABEL="sdcard_rescan_end"
