# Originally from https://serverfault.com/a/767079
# Run a mount script through systemd on any mmcblk* and sd* activity
# Io: io-detach instead of systemd-run (no systemd); block-device-event.sh
# leaves out the disk Io runs from.

KERNEL!="mmcblk*|sd*",          GOTO="steamos_automount_end"
ENV{ID_FS_USAGE}!="filesystem", GOTO="steamos_automount_end"

# The service expects to be asynchronous and shouldn't block udev rules
ACTION=="add",    RUN+="/usr/lib/hwsupport/io-detach /usr/lib/hwsupport/block-device-event.sh add %k"
ACTION=="remove", RUN+="/usr/lib/hwsupport/io-detach /usr/lib/hwsupport/block-device-event.sh remove %k"

LABEL="steamos_automount_end"
