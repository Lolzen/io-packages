# Only apply to GPU resets
SUBSYSTEM!="drm", GOTO="gpu_reset_end"
ENV{DEVTYPE}!="drm_minor", GOTO="gpu_reset_end"
KERNEL!="card*", KERNEL!="render*", GOTO="gpu_reset_end"

# If a GPU reset is caused by a specific process, kill the PID
ACTION=="change", ENV{RESET}=="1", ENV{PID}!="0", RUN+="/sbin/kill -9 %E{PID}"

# Io: SDDM is the runit service io-sddm (SteamOS: systemctl restart sddm).
# Restarting it ends whichever session runs - game mode or Plasma - and
# logs in fresh into game mode.

# Kill the session if the GPU reset and VRAM is lost
ACTION=="change", ENV{RESET}=="1", ENV{FLAGS}=="1", RUN+="/usr/bin/sv restart io-sddm"

# If a GPU reset isn't caused by a specific process, restart SDDM too
ACTION=="change", ENV{RESET}=="1", ENV{PID}=="0", ENV{FLAGS}!="1", RUN+="/usr/bin/sv restart io-sddm"

LABEL="gpu_reset_end"
