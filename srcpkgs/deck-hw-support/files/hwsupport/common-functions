# -*- shell-script -*-

make_dbus_udisks_call()
{
    local cmd=$1
    local field=$2
    local type=$3
    local object=$4
    local iface=$5
    local method=$6
    shift 6

    local ret=0
    local reply
    reply=$(busctl "${cmd}" --allow-interactive-authorization=false --expect-reply=true --json=short \
               org.freedesktop.UDisks2 "/org/freedesktop/UDisks2/${object}" \
               "org.freedesktop.UDisks2.${iface}" "${method}" "$@") || ret=$?

    if [[ $ret -ne 0 ]]; then
        echo "Error running ${cmd} ${method} on ${DEVICE} (status = $ret)" >&2
        exit 1
    fi

    # Expected reply must be of ${type} contain ${field}: value
    ret=$(jq -r "if .${field} != null and .type == \"${type}\" then .${field} else \"\" end" <<< "$reply" || true)
    if [[ -z $ret ]]; then
        echo "Error when running '${cmd} ${method}' on ${DEVICE}: udisks returned success but could not parse reply:" >&2
        echo "---"$'\n'"$reply"$'\n'"---" >&2
        exit 1
    fi

    # If we are returning an object strip the /org/freedesktop/UDisks2/ prefix
    if [[ $type = o ]]; then
        ret="${ret#/org/freedesktop/UDisks2/}"
    fi

    echo "$ret"
}

create_lock_file()
{
    local DEVBASE="$1"
    if [[ ! $DEVBASE =~ ^[a-z0-9]+$ ]]; then
        echo "Ignoring malformed device name /dev/${DEVBASE}" >&2
        return 1
    fi

    local MOUNT_LOCK="/var/run/jupiter-automount-${DEVBASE}.lock"
    exec 9<>"$MOUNT_LOCK"
    if ! flock -n 9; then
        echo "Failed to obtain lock for /dev/${DEVBASE}" >&2
        return 1
    fi
}

# Io: SteamOS keeps its own partitions out through its A/B partition list,
# which Io does not have. Io runs from a card or drive that is in use, so
# every partition on the disk / is on is left out, and anything mounted.
# Without this, the card Io boots from would be checked with fsck while
# mounted, and steamos-automount.sh would make the mount point
# world-writable (it did make / mode 777 once). When the disk behind / cannot
# be worked out, nothing is mounted: this fails closed.
# Returns 0 (true) when /dev/$1 must be left alone.
io_disk_of()
{
    lsblk -nsrpo NAME,TYPE -- "$1" 2>/dev/null | awk '$2 == "disk" { print $1; exit }'
}

io_system_disk()
{
    local -r dev="/dev/$1"
    local root_src root_disk disk

    if findmnt -rn -S "$dev" > /dev/null; then
        echo "Ignoring $dev: already mounted" >&2
        return 0
    fi
    root_src=$(findmnt -nvo SOURCE / || :)
    root_disk=$(io_disk_of "$root_src")
    if [ -z "$root_disk" ]; then
        echo "Ignoring $dev: cannot tell which disk Io runs from ($root_src)" >&2
        return 0
    fi
    disk=$(io_disk_of "$dev")
    if [ -z "$disk" ] || [ "$disk" = "$root_disk" ]; then
        echo "Ignoring $dev: on ${disk:-an unknown disk}, Io runs from $root_disk" >&2
        return 0
    fi
    return 1
}
