# Template file for 'holo-plymouth-themes'
pkgname=holo-plymouth-themes
version=0.7
revision=1
wrksrc="${pkgname}"
depends="plymouth"
hostmakedepends="git tar"
short_desc="Valve's Holo boot splash theme for Plymouth (Jupiter/LCD logo variant included)"
maintainer="Georg <funer@gmx.at>"
license="GPL-2.0-or-later"
homepage="https://gitlab.steamos.cloud/holo/holo-plymouth-themes"
distfiles="https://steamdeck-packages.steamos.cloud/archlinux-mirror/sources/holo-main/${pkgname}-${version}-1.src.tar.gz"
checksum=f2d3f6b384c8116637adc0ae7485b84290f002ae7bc8f798869b48e5de10ba4e

post_extract() {
	git --git-dir=holo-plymouth-themes archive --format=tar v${version} | tar -x
}

do_install() {
 vmkdir usr/share/plymouth/themes
	vcopy usr/share/plymouth/themes/holo usr/share/plymouth/themes/holo
	vbin usr/bin/plymouth-wrap
}