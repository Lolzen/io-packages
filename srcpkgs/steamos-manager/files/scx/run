#!/bin/sh
# Io: counterpart of SteamOS's scx.service. Starts the sched_ext scheduler
# named in /etc/default/scx (Valve's file: scx_lavd). Linked with a down
# file, as scx.service is installed but not enabled on SteamOS:
# steamos-manager starts and stops it (sv up/down) when Steam sets the CPU
# scheduler to lavd or none.
exec 2>&1
[ -r /etc/default/scx ] && . /etc/default/scx
: "${SCX_SCHEDULER:=scx_lavd}"
exec "/usr/bin/${SCX_SCHEDULER}" ${SCX_FLAGS:-}
