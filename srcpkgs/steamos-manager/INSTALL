# On installed systems the root half and the scx service are linked here (an
# image links both from its service list). scx comes with a down file, so
# runit supervises it without starting it, as scx.service is installed but
# not enabled on SteamOS; steamos-manager starts and stops it.
case "${ACTION}" in
post)
	[ -d var/service ] || exit 0
	for s in steamos-manager scx; do
		[ -e "var/service/$s" ] || ln -sf "/etc/sv/$s" var/service/
	done
	;;
esac
