         fs::create_dir_all(path(OVERRIDE_FOLDER)).await?;
         // Then write the contents into the file
-        fs::write(path(OVERRIDE_PATH), OVERRIDE_CONTENTS).await
+        Ok(fs::write(path(OVERRIDE_PATH), OVERRIDE_CONTENTS).await?)
     } else {
         // Delete it
