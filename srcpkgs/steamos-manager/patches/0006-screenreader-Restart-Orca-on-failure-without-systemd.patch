-                self.executable.display()
-            );
-            kill(running.pid, Signal::SIGKILL)?;
-            running.exited.await?;
-        }
+        // The supervisor stops restarting, terminates the child and reaps it
+        running.stop.cancel();
+        (&mut running.supervisor).await?;
         Ok(())
     }
 }
