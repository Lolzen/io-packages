+
+	cfg->rgb_leds = devm_kcalloc(&hdev->dev, led_count,
+				     sizeof(*cfg->rgb_leds), GFP_KERNEL);
+	if (!cfg->rgb_leds)
+		return -ENOMEM;
+
+	for (i = 0; i < led_count; i++) {
+		led = &cfg->rgb_leds[i];
+		ret = oxp_rgb_led_init(cfg, led, &oxp_rgb_led_descs[i]);
+		if (ret)
