+		cfg->rgb_led_count++;
+
+		ret = devm_led_classdev_multicolor_register(&hdev->dev,
+							    &led->mc_cdev);
+		if (ret)
+			return dev_err_probe(&hdev->dev, ret,
+					     "Failed to create RGB device\n");
+
+		switch (led->type) {
+		case OXP_RGB_FULL:
+			attr_group = &oxp_rgb_attr_group;
