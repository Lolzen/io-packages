# Template file for 'steamos-networking-tools'
pkgname=steamos-networking-tools
version=1.3
revision=4
depends="iwd-holo NetworkManager-holo"
short_desc="SteamOS NetworkManager defaults: Wi-Fi backend, IPv6 privacy, connectivity check"
maintainer="Georg <funer@gmx.at>"
license="LGPL-2.1-or-later"
homepage="https://gitlab.steamos.cloud/holo/holo"

# The NetworkManager defaults from steamos-customizations-jupiter
# (wpa_supplicant as backend since Valve's change of 2026-08-27, iwd
# selectable; IPv6 privacy extensions) and a connectivity check (GNOME's
# endpoint, SteamOS uses Arch's). The interface must be called wlan0 as on
# SteamOS (net.ifnames=0): iwd recreates it under the kernel name, and a
# renamed interface leaves NetworkManager looking for one that is gone.
#
# Until revision 3 this package also had Valve's steamos-wifi-set-backend
# 1.3, adapted to runit, for io-steamos-manager's backend switch. Valve's
# steamos-manager switches the backend itself (through runit on Io), so
# Io's adaptation went.

do_install() {
	vinstall ${FILESDIR}/10-steamos-defaults.conf 644 usr/lib/NetworkManager/conf.d
	vinstall ${FILESDIR}/20-connectivity.conf 644 usr/lib/NetworkManager/conf.d
}
