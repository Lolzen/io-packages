#!/bin/sh
# Valve's ec-log.service (ec-log 0.1, Steam Machine): forwards the ChromeOS EC
# console log to the system log. Linked only while Steam's EC logging switch
# is on (io-steamos-manager, FirmwareDebug1). Without the EC's log (any other
# hardware, debugfs not mounted) the service takes itself down, as Valve's
# ConditionPathExists skips the unit.
exec 2>&1
log=/sys/kernel/debug/cros_ec/console_log
if [ ! -r "$log" ]; then
	echo "ec-log: $log not available"
	exec sv down "$PWD"
fi
exec logger --tag ec-log --file "$log"
