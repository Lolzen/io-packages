# Template file for 'io-steamos-manager'
pkgname=io-steamos-manager
version=0.16.0
revision=2
python_version=3
depends="python3 python3-dbus-fast deck-hw-support dmidecode iw runit-void xbps util-linux
 steamos-networking-tools scx
 orca speech-dispatcher espeak-ng python3-evdev gsettings-desktop-schemas dconf glib
 at-spi2-core python3-pyudev"
conf_files="/etc/default/scx"
short_desc="SteamOS Manager D-Bus service for Io (root and session half)"
maintainer="Georg <funer@gmx.at>"
license="MIT"
homepage="https://github.com/Lolzen/io-packages"

do_install() {
	vbin ${FILESDIR}/io-steamos-manager.py io-steamos-manager
	vsv io-steamos-manager
	# sched_ext scheduler service (SteamOS: scx.service, disabled by default);
	# linked only while Steam's CPU scheduler is set to lavd
	vsv scx
	vinstall ${FILESDIR}/scx.default 644 etc/default scx
	vinstall ${FILESDIR}/com.steampowered.SteamOSManager1.conf 644 usr/share/dbus-1/system.d
	vinstall ${FILESDIR}/com.steampowered.Atomupd1.conf 644 usr/share/dbus-1/system.d
	# System updates from Steam with xbps: Steam's script interface and the
	# helper it shares with the Atomupd1 service of the root half.
	vbin ${FILESDIR}/steamos-update
	vmkdir usr/libexec/io
	vinstall ${FILESDIR}/io-update 755 usr/libexec/io
	vinstall ${FILESDIR}/io-steamos-manager.desktop 644 etc/xdg/autostart
	# Hardware other than the Steam Deck: Valve's device files (steamos-manager
	# 26.4.1 data/devices, MIT) for the devices with a PerformanceProfile1 or
	# a FirmwareDebug1; msi-claw-8ex.toml (new) and msi-claw-amd.toml (TDP
	# added, which Io does not implement) as on steamos-manager's main branch
	# after 26.4.1 (2026-10-07). Valve's steam-frame.toml there matches by
	# device tree (an ARM device) and is left out. Also the Steam Machine's
	# EC log service (Valve's ec-log
	# 0.1), linked only while Steam turns EC logging on. Unused on the Deck.
	vmkdir usr/share/io/steamos-manager/devices
	vcopy "${FILESDIR}/devices/*.toml" usr/share/io/steamos-manager/devices
	vsv ec-log
	vlicense ${FILESDIR}/devices/LICENSE.steamos-manager
}
