# Template file for 'io-desktop'
pkgname=io-desktop
version=0.3.0
revision=37
metapackage=yes
# Stands in for Void's base-system: base-system depends on Void's own kernel
# (linux), which would be installed next to linux-neptune-72 and does not
# boot the Deck. Its other dependencies are listed below instead, without
# linux and acpid (the power button goes through steamos-powerbuttond and
# elogind).
provides="base-system-9999_1"
replaces="base-system>=0"
# build/mkrootfs.sh installs only this package, so everything the system
# runs must be reachable from here - either listed directly or pulled in by
# one of the packages below. The IBus engines and the Noto CJK fonts at the
# end serve the Chinese, Japanese and Korean layouts of Steam's on-screen
# keyboard, as on SteamOS.
depends="
 base-files ncurses coreutils findutils diffutils libgcc dash bash grep gzip
 file sed gawk less util-linux which tar man-pages mdocml shadow e2fsprogs
 btrfs-progs xfsprogs f2fs-tools dosfstools procps-ng tzdata pciutils usbutils
 iana-etc openssh dhcpcd kbd iproute2 iputils iw wpa_supplicant xbps vim nano sudo
 void-artwork traceroute ethtool kmod eudev runit-void
 removed-packages glibc-locales
 void-repo-nonfree void-repo-multilib void-repo-multilib-nonfree

 io-base io-branding io-session io-steamos-manager
 linux-neptune-72 linux-firmware deck-firmware deck-hw-support
 jupiter-fan-control steamos-powerbuttond

 steamdeck-dsp holo-zram-swap holo-earlyoom steamos-tuning
 holo-dmi-rules holo-fstab-repair steamos-passwd
 vpower holo-upower-config

 gamescope gamescope-wsi-32bit steam-jupiter steam-im-modules steamdeck-kde-presets gamemode
 steamos-systemreport gstreamer1-pipewire wireless-regdb
 holo-sudo holo-realtek-firmware-toggles steam-web-debug-portforward jupiter-firewall
 cecd cec-audio-control steamos-devkit-service gpu-trace io-release
 MangoHud-holo MangoHud-32bit MangoHud-mangoapp-holo
 mesa-dri mesa-dri-32bit mesa-vulkan-radeon mesa-vulkan-radeon-32bit libcurl-32bit
 mesa-vaapi mesa-vaapi-32bit
 pipewire wireplumber wireplumber-elogind alsa-pipewire sof-firmware alsa-utils libspa-bluetooth

 NetworkManager elogind polkit dbus
 xdg-desktop-portal xdg-desktop-portal-gamescope xdg-desktop-portal-holo

 bluez chrony dracut grub-x86_64-efi efibootmgr
 fastfetch dmidecode

 kde-plasma konsole dolphin kate ark gwenview okular spectacle kdeconnect
 partitionmanager plasma-keyboard xdg-desktop-portal-gtk kio-extras kdialog octoxbps

 ibus ibus-pinyin ibus-table-cangjie-lite ibus-anthy-holo ibus-hangul
 noto-fonts-cjk
"
short_desc="Io meta package: complete Steam Deck game mode system"
