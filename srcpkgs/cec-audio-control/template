# Lets PipeWire drive the TV's volume and mute over CEC (org.pipewire.
# ExternalVolume). On SteamOS a socket-activated user service; without
# systemd it creates the same socket itself in $XDG_RUNTIME_DIR, started
# by Io's session scripts (io-session).
post_extract() {
	mkdir -p src
	git --git-dir=cec-audio-control-0.1.0 archive --format=tar ${_commit} | tar -x -C src
}

do_install() {
	vbin target/${RUST_TARGET}/release/cec-audio-control
	vlicense LICENSE
}
