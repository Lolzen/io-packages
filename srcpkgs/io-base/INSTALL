case "${ACTION}" in
post)
	usr/libexec/io/io-i18n-supported 2>/dev/null || true
	# GRUB without its menu: Io boots at once, as SteamOS does. A boot that
	# goes wrong ends in dracut's emergency shell anyway; the recovery stick
	# keeps its menu. grub (a dependency) is configured before this runs.
	if [ -f etc/default/grub ]; then
		sed -i 's/^GRUB_TIMEOUT=.*/GRUB_TIMEOUT=0/' etc/default/grub
		grep -q '^GRUB_TIMEOUT=' etc/default/grub || echo 'GRUB_TIMEOUT=0' >> etc/default/grub
		if grep -q '^GRUB_TIMEOUT_STYLE=' etc/default/grub; then
			sed -i 's/^GRUB_TIMEOUT_STYLE=.*/GRUB_TIMEOUT_STYLE=hidden/' etc/default/grub
		else
			echo 'GRUB_TIMEOUT_STYLE=hidden' >> etc/default/grub
		fi
		# amdgpu.dcdebugmask 0x20000 -> 0x60000, as SteamOS since
		# jupiter-hw-support 20261028.1: bit 0x40000 turns the firmware's
		# custom brightness curve off, so brightness stays linear and reaches
		# 100 % (Valve's kernel 7.3 no longer forces the linear curve). Only
		# the value Io's images wrote is changed, not one set by hand.
		sed -i 's/amdgpu\.dcdebugmask=0x20000\([ "]\)/amdgpu.dcdebugmask=0x60000\1/' etc/default/grub
		# Into grub.cfg now on an installed system (an image build runs
		# grub-mkconfig itself).
		if [ -f boot/grub/grub.cfg ] && command -v grub-mkconfig > /dev/null 2>&1; then
			grub-mkconfig -o boot/grub/grub.cfg > /dev/null 2>&1 || echo "io-base: grub-mkconfig failed; run: grub-mkconfig -o /boot/grub/grub.cfg"
		fi
	fi
	;;
esac
