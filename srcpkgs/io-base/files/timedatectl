#!/bin/sh
# Minimal timedatectl replacement for Void (no systemd).
# Steam only calls set-timezone, through steamos-set-timezone; the other
# subcommands are there for completeness.

ZONEDIR=/usr/share/zoneinfo

case "$1" in
    set-timezone)
        [ -n "$2" ] || exit 1
        [ -f "$ZONEDIR/$2" ] || exit 1
        ln -sf "$ZONEDIR/$2" /etc/localtime
        printf '%s\n' "$2" > /etc/timezone
        ;;
    show)
        printf '%s\n' "$(readlink -f /etc/localtime | sed "s|$ZONEDIR/||")"
        ;;
    list-timezones)
        find "$ZONEDIR" -type f -not -name '*.tab' -not -name 'posixrules' -printf '%P\n' | sort
        ;;
    status|"")
        printf '               Local time: %s\n' "$(date)"
        printf '                Time zone: %s\n' "$(readlink -f /etc/localtime | sed "s|$ZONEDIR/||")"
        ;;
    *)
        exit 0
        ;;
esac