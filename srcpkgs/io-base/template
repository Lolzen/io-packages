# Template file for 'io-base'
pkgname=io-base
version=0.3.0
revision=1
bootstrap=yes
depends="xbps>=0.45"
conf_files="/etc/elogind/logind.conf.d/10-io.conf"
short_desc="Io base configuration for Steam Deck"
maintainer="Georg <funer@gmx.at>"
license="MIT"
homepage="https://github.com/Lolzen/io-packages"

do_install() {
	vmkdir usr/share/xbps.d
	vinstall ${FILESDIR}/20-io.conf 644 usr/share/xbps.d
	vmkdir etc/elogind/logind.conf.d
	vinstall ${FILESDIR}/logind-io.conf 644 etc/elogind/logind.conf.d 10-io.conf
	vmkdir usr/lib/dracut/dracut.conf.d
	vinstall ${FILESDIR}/dracut-io.conf 644 usr/lib/dracut/dracut.conf.d 10-io.conf
}