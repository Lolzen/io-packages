# Template file for 'io-base'
pkgname=io-base
version=0.7.0
revision=1
depends="polkit socklog-void plymouth alsa-pipewire efibootmgr util-linux
 grub-x86_64-efi"
conf_files="/etc/elogind/logind.conf.d/10-io.conf /etc/sv/bluetoothd/conf
 /etc/default/io-bootnext"
short_desc="Io base configuration for Steam Deck"
maintainer="Georg <funer@gmx.at>"
license="MIT"
homepage="https://github.com/Lolzen/io-packages"

do_install() {
	vmkdir usr/share/xbps.d
	vinstall ${FILESDIR}/20-io.conf 644 usr/share/xbps.d
	vmkdir etc/elogind/logind.conf.d
	vinstall ${FILESDIR}/logind-io.conf 644 etc/elogind/logind.conf.d 10-io.conf
	vmkdir usr/lib/dracut/dracut.conf.d
	vinstall ${FILESDIR}/dracut-io.conf 644 usr/lib/dracut/dracut.conf.d 10-io.conf
	vbin ${FILESDIR}/timedatectl
	# Route plain ALSA clients through PipeWire, as SteamOS does. Void's
	# alsa-pipewire ships these files but leaves enabling them to the admin;
	# without them ALSA's default device opens the hardware directly, which
	# PipeWire already holds, and ALSA-only games stay silent.
	vmkdir etc/alsa/conf.d
	ln -s /usr/share/alsa/alsa.conf.d/50-pipewire.conf ${DESTDIR}/etc/alsa/conf.d/
	ln -s /usr/share/alsa/alsa.conf.d/99-pipewire-default.conf ${DESTDIR}/etc/alsa/conf.d/
	vmkdir etc/runit/shutdown.d
	vinstall ${FILESDIR}/05-io-ssh-sessions.sh 644 etc/runit/shutdown.d
	# Restart from Io starts Io again (UEFI BootNext, next boot only)
	vinstall ${FILESDIR}/75-io-bootnext.sh 644 etc/runit/shutdown.d
	vmkdir etc/default
	vinstall ${FILESDIR}/io-bootnext.default 644 etc/default io-bootnext
	# /usr/share/i18n/SUPPORTED, regenerated from libc-locales (as on Arch)
	vmkdir usr/libexec/io
	vinstall ${FILESDIR}/io-i18n-supported 755 usr/libexec/io
	vinstall ${FILESDIR}/io-bootnext 755 usr/libexec/io
	vmkdir etc/runit/core-services
	vinstall ${FILESDIR}/12-io-i18n-supported.sh 644 etc/runit/core-services
	# SteamOS's BlueZ settings (Valve patches them into bluez's main.conf),
	# as a file of Io's own that Void's bluetoothd service is pointed at, so
	# Void's /etc/bluetooth/main.conf stays untouched.
	vmkdir usr/share/io/bluetooth
	vinstall ${FILESDIR}/bluetooth-main.conf 644 usr/share/io/bluetooth main.conf
	vmkdir etc/sv/bluetoothd
	vinstall ${FILESDIR}/bluetoothd.conf 644 etc/sv/bluetoothd conf
}