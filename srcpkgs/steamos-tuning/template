# Template file for 'steamos-tuning'
pkgname=steamos-tuning
version=1.5
revision=1
depends="util-linux e2fsprogs bash"
short_desc="Valve's SteamOS tuning: sysctls, limits, scheduler, HID preload, swap, hibernation"
maintainer="Georg <funer@gmx.at>"
license="LGPL-2.1-or-later"
homepage="https://github.com/Lolzen/io-packages"

# Values match /usr/lib/sysctl.d on SteamOS 3.8.4 and 3.9.2 (captured on
# hardware). 50-pid-max.conf and 50-io-inherited.conf add what SteamOS
# inherits from Arch and systemd rather than setting it itself;
# 50-io-nofile.conf does the same for systemd's open-file limit.
#
# From steamos-customizations-jupiter (on SteamOS 3.8.4 and 3.9.2 unless
# noted):
#   hid-preload.conf - hid_nintendo and hid_playstation load early, so they
#     claim their controllers before Steam falls back to evdev.
#   holo-cfs-debugfs-settings - scheduler tunings through debugfs, run by
#     the core service 70-io-cfs-tunings.sh (mounts debugfs, which systemd
#     does on its own).
#   10-holo-virtualdisplaysize.conf - screen size for an X server started
#     without a display. Neither Xwayland nor gamescope read it; it is kept
#     for a later X11 session (VNC, other flavours).
#   holo-create-swapfile - Valve's 1 GiB swap file in /home next to zram,
#     created and switched on by the core service 60-io-swapfile.sh.
#   ntsync.conf - loads NTSync early (a module in Valve's kernel config,
#     which linux-neptune-72 follows from revision 4).
#   15-proton-nice.conf - lets Proton raise its game threads to nice -8.
#     Valve's package put it in /etc/limits.d, which pam_limits does not
#     read, so it had no effect on 3.8.4; 3.9.2 has it in
#     /etc/security/limits.d and game threads run at nice -1, -2 and -8.
#     pam_limits is part of Void's system-auth, which SDDM's login uses.
#   libva.sh - LIBVA_DRIVER_NAME=radeonsi for every login (profile.d),
#     written by Valve's PKGBUILD.
#   holo.sh - EDITOR=vim (and VISUAL=gvim) unless set, as on SteamOS.
#   20-steam-deck.conf - the Deck modules of Valve's mkinitcpio hook
#     "steam-deck" as a dracut configuration (dracut is Void's initramfs
#     generator). INSTALL rebuilds existing initramfs images once when the
#     list changes, as pacman does for a changed mkinitcpio hook.
#   steamos-suspend-then-hibernate.conf - Valve's suspend-then-hibernate
#     (hibernate after 20 minutes of suspend), in elogind's sleep.conf.d,
#     without HibernateOnACPower=no, which elogind 252 does not know: on AC
#     power the Deck hibernates after the delay as well.
#   hibernate-swap-helper.sh - Valve's: the swap file for the image (RAM
#     plus VRAM) is created when hibernating and removed after resuming.
# Everything ported here is identical in 20260827.2, the version of SteamOS
# 3.9.2 (checked 2026-10-04).
#
# Io's own for hibernation:
#   61-io-hibernate-guard.sh - hibernation only when / is on the internal
#     NVMe (and the Deck booted with UEFI); elsewhere elogind is told it is
#     not allowed (see the file).
#   io-hibernate - elogind sleep hook in place of Valve's
#     hibernate-prepare.service and system-sleep/hibernate-post.sh: runs the
#     helper and writes where the image is to an EFI variable of Io's own
#     (IoHibernateLocation), which systemd does on SteamOS.
#   90io-resume, 21-io-resume.conf - dracut module that reads that variable
#     at boot and resumes from the image, in place of systemd's
#     systemd-hibernate-resume-generator.
#   Valve's logind drop-in that sets SYSTEMD_BYPASS_HIBERNATION_MEMORY_CHECK
#     (the swap that exists before hibernating is too small for logind's
#     check) is part of the elogind overlay (overlay/elogind).
# Not tested yet: hibernation needs Io on the NVMe.
# Not included on purpose:
#   20-panic-sysctls.conf, 21-steamos-panic-sysctls.conf - reboot on kernel
#     panic; Valve pairs this with its crash log submitter, Io has none yet,
#     so a frozen device is more useful for debugging during the alpha.
# Void's own hardening sysctls (base-files: kptr_restrict, kexec_load_disabled,
# unprivileged_bpf_disabled) stay as Void sets them; SteamOS has 0, 0 and 2.
do_install() {
	vmkdir usr/lib/sysctl.d
	vinstall ${FILESDIR}/20-mtu-probing.conf 644 usr/lib/sysctl.d
	vinstall ${FILESDIR}/20-net-timeout.conf 644 usr/lib/sysctl.d
	vinstall ${FILESDIR}/20-sched.conf 644 usr/lib/sysctl.d
	vinstall ${FILESDIR}/30-splitlock.conf 644 usr/lib/sysctl.d
	vinstall ${FILESDIR}/30-vm.conf 644 usr/lib/sysctl.d
	vinstall ${FILESDIR}/50-pid-max.conf 644 usr/lib/sysctl.d
	vinstall ${FILESDIR}/50-io-inherited.conf 644 usr/lib/sysctl.d
	vmkdir etc/security/limits.d
	vinstall ${FILESDIR}/15-proton-nice.conf 644 etc/security/limits.d
	vinstall ${FILESDIR}/50-io-nofile.conf 644 etc/security/limits.d
	vmkdir etc/profile.d
	vinstall ${FILESDIR}/libva.sh 644 etc/profile.d
	vinstall ${FILESDIR}/holo.sh 644 etc/profile.d
	vmkdir usr/lib/modules-load.d
	vinstall ${FILESDIR}/hid-preload.conf 644 usr/lib/modules-load.d
	vinstall ${FILESDIR}/ntsync.conf 644 usr/lib/modules-load.d
	vmkdir usr/lib/dracut/dracut.conf.d
	vinstall ${FILESDIR}/20-steam-deck.conf 644 usr/lib/dracut/dracut.conf.d
	vinstall ${FILESDIR}/21-io-resume.conf 644 usr/lib/dracut/dracut.conf.d
	vmkdir usr/lib/dracut/modules.d/90io-resume
	vinstall ${FILESDIR}/90io-resume/module-setup.sh 755 usr/lib/dracut/modules.d/90io-resume
	vinstall ${FILESDIR}/90io-resume/io-resume.sh 755 usr/lib/dracut/modules.d/90io-resume
	vmkdir usr/lib/elogind/sleep.conf.d
	vinstall ${FILESDIR}/steamos-suspend-then-hibernate.conf 644 usr/lib/elogind/sleep.conf.d
	vmkdir usr/libexec/elogind/system-sleep
	vinstall ${FILESDIR}/io-hibernate 755 usr/libexec/elogind/system-sleep
	vmkdir usr/libexec/holo
	vinstall ${FILESDIR}/hibernate-swap-helper.sh 755 usr/libexec/holo
	vinstall ${FILESDIR}/holo-cfs-debugfs-settings 755 usr/libexec
	vmkdir etc/runit/core-services
	vinstall ${FILESDIR}/holo-create-swapfile 755 usr/libexec
	vinstall ${FILESDIR}/60-io-swapfile.sh 644 etc/runit/core-services
	vinstall ${FILESDIR}/61-io-hibernate-guard.sh 644 etc/runit/core-services
	vinstall ${FILESDIR}/70-io-cfs-tunings.sh 644 etc/runit/core-services
	vmkdir usr/share/X11/xorg.conf.d
	vinstall ${FILESDIR}/10-holo-virtualdisplaysize.conf 644 usr/share/X11/xorg.conf.d
}
