# The Deck modules in 20-steam-deck.conf and the dracut module io-resume only
# reach the initramfs when it is rebuilt. SteamOS's pacman rebuilds it
# whenever a mkinitcpio hook changes; here the existing initramfs images are
# rebuilt once when these files differ from the ones they were last built
# with. A kernel installed later builds its own initramfs with them anyway,
# so a missing image is left to the kernel's hook.

case "${ACTION}" in
post)
	_sum=var/lib/steamos-tuning/initramfs-modules.sum
	_hook=etc/kernel.d/post-install/20-initramfs
	_new=$(cat usr/lib/dracut/dracut.conf.d/20-steam-deck.conf \
		usr/lib/dracut/dracut.conf.d/21-io-resume.conf \
		usr/lib/dracut/modules.d/90io-resume/module-setup.sh \
		usr/lib/dracut/modules.d/90io-resume/io-resume.sh | cksum)
	_old=$(cat "${_sum}" 2>/dev/null)
	if [ "${_new}" != "${_old}" ]; then
		for _dir in usr/lib/modules/*/; do
			_ver=${_dir%/}
			_ver=${_ver##*/}
			[ -f "boot/initramfs-${_ver}.img" ] || continue
			[ -x "${_hook}" ] || continue
			echo "Rebuilding the initramfs for ${_ver} (Deck modules or io-resume changed)"
			"${_hook}" ${PKGNAME} "${_ver}"
		done
		mkdir -p var/lib/steamos-tuning
		echo "${_new}" > "${_sum}"
	fi
	;;
esac
