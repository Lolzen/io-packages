# The Deck modules in 20-steam-deck.conf only reach the initramfs when it
# is rebuilt. SteamOS's pacman rebuilds it whenever a mkinitcpio hook
# changes; here the existing initramfs images are rebuilt once when the
# list differs from the one they were last built with. A kernel installed
# later builds its own initramfs with the list anyway, so a missing image
# is left to the kernel's hook.
case "${ACTION}" in
post)
	_conf=usr/lib/dracut/dracut.conf.d/20-steam-deck.conf
	_sum=var/lib/steamos-tuning/initramfs-modules.sum
	_hook=etc/kernel.d/post-install/20-initramfs
	_new=$(cksum < "${_conf}")
	_old=$(cat "${_sum}" 2>/dev/null)
	if [ "${_new}" != "${_old}" ]; then
		for _dir in usr/lib/modules/*/; do
			_ver=${_dir%/}
			_ver=${_ver##*/}
			[ -f "boot/initramfs-${_ver}.img" ] || continue
			[ -x "${_hook}" ] || continue
			echo "Rebuilding the initramfs for ${_ver} (Deck modules changed)"
			"${_hook}" ${PKGNAME} "${_ver}"
		done
		mkdir -p var/lib/steamos-tuning
		echo "${_new}" > "${_sum}"
	fi
	;;
esac
