# Template file for 'holo-sudo'
pkgname=holo-sudo
version=3.8.20260422.1
revision=1
depends="sudo"
short_desc="SteamOS sudo configuration: wheel and sudo groups, no FQDN lookup"
maintainer="Georg <funer@gmx.at>"
license="LGPL-2.1-or-later"
homepage="https://gitlab.steamos.cloud/holo/holo"
conf_files="/etc/sudoers.d/wheel /etc/sudoers.d/sudo /etc/sudoers.d/no-fqdn"

# Valve's three files as on SteamOS 3.8.4 (captured on hardware). no-fqdn
# keeps sudo from hanging while it resolves the host name with no network
# or a broken DNS server. The group "sudo" does not exist on Void; the rule
# does nothing then, as on any system without that group.

do_install() {
	for f in wheel sudo no-fqdn; do
		vinstall ${FILESDIR}/${f} 440 etc/sudoers.d
	done
}
