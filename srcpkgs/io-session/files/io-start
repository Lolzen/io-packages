#!/bin/sh
# io-start <gamemode|desktop> - start a session under its own D-Bus session
# bus. SDDM runs it from the session files (gamescope-wayland.desktop,
# io-desktop.desktop); which one it picks, io-steamos-manager decides.
#
# All output of the session (gamescope, Steam, Plasma, PipeWire, ...) goes
# to a size-limited log instead of tty1:
#   /run/user/<uid>/io-log-<session>/current   (RAM, gone after reboot)
# svlogd from runit rotates it: at most 5 files of 2 MB per session.
#
# Developer mode (see io-devmode) additionally keeps the logs across
# reboots under ~/.local/state/io/log-<session>.

# SDDM opens the login through PAM; pam_elogind creates the runtime
# directory and sets XDG_RUNTIME_DIR before SDDM starts this script.
RUNDIR="${XDG_RUNTIME_DIR:-}"
if [ -z "$RUNDIR" ] || [ ! -d "$RUNDIR" ]; then
    echo "io: XDG_RUNTIME_DIR is missing, check elogind and SDDM's PAM setup." >&2
    exit 1
fi

SESSION="${1:-gamemode}"
case "$SESSION" in
    desktop) PROG=/usr/bin/io-plasma ;;
    *) SESSION=gamemode; PROG=/usr/bin/io-gamemode ;;
esac

LOGDIR="$RUNDIR/io-log-$SESSION"
KEEP=5
if command -v io-devmode > /dev/null && io-devmode; then
    LOGDIR="$HOME/.local/state/io/log-$SESSION"
    KEEP=20
fi
mkdir -p "$LOGDIR"
printf 's2000000\nn%s\n' "$KEEP" > "$LOGDIR/config"

echo "io: starting $SESSION, log: $LOGDIR/current"

# The logger reads from a FIFO in the background, and io-start waits only
# for the session itself. A plain "session | svlogd" pipe would only end
# once every process holding its write end is gone - and processes that
# outlive the session (PipeWire, portals) kept it open, so io-start never
# returned and the next session never started.
# A logger left over from an earlier run of this session type still holds
# the directory lock; end it first, or the new one could not start.
pkill -u "$(id -u)" -f "svlogd -tt $LOGDIR" 2> /dev/null
FIFO="$LOGDIR/.fifo"
rm -f "$FIFO"
mkfifo "$FIFO"
svlogd -tt "$LOGDIR" < "$FIFO" &
dbus-run-session -- "$PROG" > "$FIFO" 2>&1

# Whatever the session started and left running (PipeWire on the bus that
# is gone now, steamos-powerbuttond) ends with the login when this script
# returns: KillUserProcesses=yes (10-io-kill-user-processes.conf). The next
# session starts a fresh PipeWire on its own bus.
exit 0
