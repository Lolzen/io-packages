#!/bin/sh
# io-gamemode - Io's game mode session, modelled on Valve's
# /usr/lib/steamos/gamescope-session and /usr/lib/steamos/steam-launcher
# (SteamOS 3.8.4, captured on real hardware).
#
# Valve runs gamescope and Steam as two systemd user units and passes the
# X/Wayland display names through a startup socket. Io has no user units,
# so gamescope launches Steam directly as its child, which makes the
# startup socket (-R) unnecessary.
#
# Variables are split in two groups:
#   A - set exactly like Valve does, Io has everything they depend on
#   B - Valve sets them too, but they depend on something Io does not ship
#       yet (cecd, udisks storage helpers,
#       systemd scopes). Setting them now would show controls in Steam
#       that silently do nothing. Enable one by one once the dependency
#       exists.

if pgrep -x gamescope-wl > /dev/null; then
    echo "io: gamescope already running" >&2
    exit 1
fi

export XDG_RUNTIME_DIR=/run/user/$(id -u)
STATE="$XDG_RUNTIME_DIR/io-session-next"
echo gamemode > "$STATE"

# ------------------------------------------------------------ helpers
# Valve runs the filter chain as its own PipeWire instance
# (filter-chain.service), with a fixed quantum, locked memory and a single
# malloc arena - settings that would be wrong for the main daemon. prlimit
# raises this process's memlock soft limit to the hard limit io-autologin
# set; MALLOC_ARENA_MAX matches Valve's drop-in.
start_filter_chain() {
    pgrep -f "pipewire -c filter-chain.conf" > /dev/null && return
    # Wait for the main daemon's socket in the background: a PipeWire client
    # started before it exits instead of retrying. Valve gets the ordering
    # from socket activation.
    (
        i=0
        while [ ! -S "$XDG_RUNTIME_DIR/pipewire-0" ] && [ $i -lt 15 ]; do
            sleep 1
            i=$((i + 1))
        done
        MALLOC_ARENA_MAX=1 exec prlimit --memlock=104857600 pipewire -c filter-chain.conf
    ) > /dev/null 2>&1 &
}

# mangoapp draws Steam's performance overlay. Valve runs it as its own
# service with Restart=always and hands it the session environment; here a
# loop tied to gamescope does the same. Steam itself sets the STEAM_*MANGOAPP*
# variables; the config file and the stats pipe are ours to provide.
#
# It is started right before gamescope, after the whole environment is set:
# started earlier, it missed MANGOHUD_CONFIGFILE, never saw the overlay level
# Steam writes there, and showed its default overlay in every game.
#
# It has to wait for gamescope to be up *and* for its X socket: the socket
# file from the previous session survives in /tmp, so checking only for the
# socket succeeds immediately - before gamescope even starts, since this
# runs ahead of it.
start_mangoapp() {
    command -v mangoapp > /dev/null 2>&1 || return
    (
        i=0
        while ! pgrep -x gamescope-wl > /dev/null || [ ! -S /tmp/.X11-unix/X0 ]; do
            [ "$i" -ge 30 ] && exit 0
            sleep 1
            i=$((i + 1))
        done
        export DISPLAY=:0
        export GAMESCOPE_WAYLAND_DISPLAY=gamescope-0
        while pgrep -x gamescope-wl > /dev/null; do
            mangoapp
            sleep 1
        done
    ) > /dev/null 2>&1 &
}

pgrep -x pipewire > /dev/null || pipewire &
start_filter_chain
pgrep -f steamos-powerbuttond > /dev/null || setsid /usr/lib/hwsupport/steamos-powerbuttond > /dev/null 2>&1 &
# user half only - the root half (io-steamos-manager -r) runs as a runit service
pgrep -u "$(id -u)" -f io-steamos-manager > /dev/null || setsid /usr/bin/io-steamos-manager > /dev/null 2>&1 &

# ----------------------------------------------------- session identity
export XDG_CURRENT_DESKTOP=gamescope
export XDG_SESSION_DESKTOP=gamescope
export DESKTOP_SESSION=gamescope-wayland
export XDG_SESSION_TYPE=x11

# As Valve's start-gamescope-session: game mode sees only the gamescope
# portal, not the KDE and GTK ones Plasma installs (they crash here without
# a KDE session). Set in the bus's activation environment, because D-Bus -
# not this script - starts xdg-desktop-portal.
export XDG_DESKTOP_PORTAL_DIR=/usr/share/xdg-desktop-portal/gamescope-portals
dbus-update-activation-environment XDG_DESKTOP_PORTAL_DIR

# ------------------------------------------------- A: same as Valve
export SDL_VIDEO_MINIMIZE_ON_FOCUS_LOSS=0
export HOMETEST_DESKTOP=1
export HOMETEST_DESKTOP_SESSION=plasma

# Written as no_display first, like Valve does, so the overlay does not
# appear while Steam is still starting. Steam rewrites the file when the
# overlay level is changed.
GS_TMPDIR=$(mktemp -p "$XDG_RUNTIME_DIR" -d gamescope.XXXXXXX)
export MANGOHUD_CONFIGFILE="$GS_TMPDIR/mangohud.config"
echo no_display > "$MANGOHUD_CONFIGFILE"

# gamescope's statistics pipe (-T), as in Valve's session: frame timing that
# mangoapp reads. The session also claims $XDG_RUNTIME_DIR/gamescope-stats
# for other tools, under a lock held on fd 9 for as long as gamescope runs.
export GAMESCOPE_STATS="$GS_TMPDIR/stats.pipe"
mkfifo -- "$GAMESCOPE_STATS"
gs_statslink="$XDG_RUNTIME_DIR/gamescope-stats"
exec 9> "$gs_statslink.lck"
if flock -n 9 && rm -f "$gs_statslink" && ln -sf "$GS_TMPDIR" "$gs_statslink"; then
    echo >&2 "io: claimed global gamescope stats session at $gs_statslink"
else
    echo >&2 "io: failed to claim global gamescope stats session"
fi

export STEAM_USE_DYNAMIC_VRS=1
export RADV_FORCE_VRS_CONFIG_FILE="$(mktemp /tmp/radv_vrs.XXXXXXXX)"
echo "1x1" > "$RADV_FORCE_VRS_CONFIG_FILE"

CFG="${XDG_CONFIG_HOME:-$HOME/.config}/gamescope"
mkdir -p "$CFG"
export GAMESCOPE_MODE_SAVE_FILE="$CFG/modes.cfg"
export GAMESCOPE_PATCHED_EDID_FILE="$CFG/edid.bin"
touch "$GAMESCOPE_MODE_SAVE_FILE" "$GAMESCOPE_PATCHED_EDID_FILE"

export GAMESCOPE_NV12_COLORSPACE=k_EStreamColorspace_BT601
export STEAM_GAMESCOPE_HDR_SUPPORTED=1
export VKD3D_SWAPCHAIN_LATENCY_FRAMES=3
export WINEDLLOVERRIDES=dxgi=n

export STEAM_ENABLE_DYNAMIC_BACKLIGHT=1
export STEAM_ENABLE_FAN_CONTROL=1
export STEAM_ENABLE_VOLUME_HANDLER=1
export SRT_URLOPEN_PREFER_STEAM=1
export STEAM_DISABLE_AUDIO_DEVICE_SWITCHING=1
export STEAM_MULTIPLE_XWAYLANDS=1
export STEAM_GAMESCOPE_DYNAMIC_FPSLIMITER=1
export STEAM_GAMESCOPE_HAS_TEARING_SUPPORT=1
export STEAM_GAMESCOPE_NIS_SUPPORTED=1
export STEAM_GAMESCOPE_TEARING_SUPPORTED=1
export STEAM_GAMESCOPE_VRR_SUPPORTED=1
export STEAM_GAMESCOPE_DYNAMIC_REFRESH_IN_STEAM_SUPPORTED=0
export vk_xwayland_wait_ready=false
export STEAM_GAMESCOPE_FANCY_SCALING_SUPPORT=1
export STEAM_GAMESCOPE_COLOR_MANAGED=1
export STEAM_GAMESCOPE_VIRTUAL_WHITE=1
export QT_QPA_PLATFORM_THEME=kde
export ENABLE_GAMESCOPE_WSI=1
export GAMESCOPE_LIMITER_FILE="$(mktemp /tmp/gamescope-limiter.XXXXXXXX)"
export GAMESCOPE_DISABLE_ASYNC_FLIPS=1

board=$(cat /sys/class/dmi/id/board_name 2>/dev/null)
if [ "$board" = "Jupiter" ]; then
    export STEAM_DISPLAY_REFRESH_LIMITS=40,60
fi
# Valve points Steam's update screen at its boot splash image; Io uses its own
bg=/usr/share/plymouth/themes/io/io.png
[ -r "$bg" ] && export STEAM_UPDATEUI_PNG_BACKGROUND="$bg"

# ---------------------------------------- B: waiting for a dependency
# cecd (HDMI-CEC daemon):
#export STEAM_ENABLE_CEC=1
# Status LED brightness control (Jupiter has one too, status:white); the LED
# is writable for deck through steam-jupiter's udev rule.
export STEAM_ENABLE_STATUS_LED_BRIGHTNESS=1
# Storage1 (format/unmount helpers + udisks2):
#export STEAM_ALLOW_DRIVE_UNMOUNT=1
#export STEAM_ALLOW_DRIVE_ADOPT=1
# needs systemd scopes:
#export STEAM_LAUNCH_WRAPPER_SCOPE=1
# Steam's on-screen keyboard as input method for GTK and Qt 5 apps
# (steam-im-modules):
export QT_IM_MODULE=steam
export GTK_IM_MODULE=Steam
# Valve's cursor theme (deck-hw-support):
export XCURSOR_THEME=steam
export XCURSOR_SCALE=256

# Valve raises the fd limit for the whole session (esync, Steam itself)
ulimit -n 524288 2>/dev/null || ulimit -n "$(ulimit -Hn)"

# -------------------------------------------------------------- launch
set -- --generate-drm-mode fixed
set -- "$@" --xwayland-count 2
set -- "$@" -w 1280 -h 800
set -- "$@" --default-touch-mode 4
set -- "$@" --hide-cursor-delay 3000
set -- "$@" --max-scale 2
set -- "$@" --fade-out-duration 200
set -- "$@" --cursor-scale-height 720
set -- "$@" -e -T "$GAMESCOPE_STATS"
set -- "$@" -O '*',eDP-1

# steam-jupiter is Valve's Deck wrapper: it keeps Steam on the Deck's
# branch and adds -steamdeck -pipewire, so the full command line matches
# SteamOS (including -steamdeck twice).
start_mangoapp
exec gamescope "$@" -- steam-jupiter -steamos3 -steampal -steamdeck -gamepadui
