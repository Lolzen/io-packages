#!/bin/sh
[ -r conf ] && . ./conf
if [ -z "$IO_USER" ]; then
    IO_USER=$(awk -F: '$3 >= 1000 && $3 < 65534 { print $1; exit }' /etc/passwd)
fi
[ -n "$IO_USER" ] || exit 1
i=0
while [ ! -S /run/dbus/system_bus_socket ] && [ $i -lt 10 ]; do
    sleep 1
    i=$((i + 1))
done
# Hand the screen over from the boot splash. Not --retain-splash: it leaves
# the console in graphics mode, so nothing written to tty1 shows up - not
# io-netcheck's network prompt on first boot, not the fallback shell.
if command -v plymouth > /dev/null 2>&1 && plymouth --ping 2> /dev/null; then
    plymouth quit
fi
# MEMLOCK: hard limit 100 MB for the session, soft left at the default, as
# Valve does (8 MB for the user manager, 100 MB only for filter-chain.service).
# Only root can raise the hard limit, so it happens here; the filter chain
# raises its own soft limit within it.
exec prlimit --memlock=8388608:104857600 chpst -P agetty --noclear --autologin "$IO_USER" tty1 38400 linux