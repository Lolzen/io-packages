#!/bin/sh
# steamos-session-select <plasma|gamescope>
#
# Legacy entry point, kept for Steam client compatibility (Valve's own
# version is a thin wrapper around steamosctl nowadays). Current Steam
# clients switch sessions through io-steamos-manager's SessionManagement1
# over D-Bus instead; this script is still used by the "Return to Game
# Mode" desktop shortcut.
#
# It only records the target session in a state file that io-start reads
# on the next login. When called from Steam it runs inside the
# pressure-vessel container, where pgrep/pkill cannot see host processes,
# so it cannot end the running session itself in that case.
#
# When called from the desktop session (the shortcut) it runs outside the
# container and ends kwin itself.

STATE="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/io-session-next"

case "$1" in
    plasma|plasma-x11|desktop)
        echo desktop > "$STATE" || exit 1
        ;;
    gamescope|steamos|steam)
        echo gamemode > "$STATE" || exit 1
        ;;
    *)
        echo "steamos-session-select: unbekanntes Ziel '$1'" >&2
        echo "Verwendung: steamos-session-select <plasma|gamescope>" >&2
        exit 1
        ;;
esac

# End the desktop session if visible. Detached, so this script can return
# before its parent process dies with the session.
if pgrep -x kwin_wayland > /dev/null 2>&1; then
    setsid sh -c 'sleep 1; pkill -TERM kwin_wayland' > /dev/null 2>&1 &
fi

exit 0
