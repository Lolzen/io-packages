#!/bin/sh
# steamos-session-select - kept for Steam client compatibility, as on
# SteamOS, where it is a thin wrapper around steamosctl. Same mapping as
# Valve's; Io has one desktop session, which every plasma variant selects.
# io-steamos-manager (SessionManagement1) does the switch: it tells SDDM
# which session to log in next and ends the running one.
set -e
SVC=com.steampowered.SteamOSManager1
OBJ=/com/steampowered/SteamOSManager1
SM=$SVC.SessionManagement1

call() {
    busctl --user call $SVC $OBJ $SM "$1" > /dev/null
}
set_mode() {
    busctl --user set-property $SVC $OBJ $SM DefaultLoginMode s "$1"
}

session="${1:-gamescope}"
case "$session" in
    plasma-wayland-persistent|plasma-x11-persistent)
        set_mode desktop
        call SwitchToDesktopMode
        ;;
    plasma|plasma-wayland|desktop)
        call SwitchToDesktopMode
        ;;
    gamescope)
        set_mode game
        call SwitchToGameMode
        ;;
    *)
        echo >&2 "!! Unrecognized session '$session'"
        exit 1
        ;;
esac
