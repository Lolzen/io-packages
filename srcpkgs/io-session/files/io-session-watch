#!/bin/sh
STATE="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/io-session-next"

# warten, bis gamescope laeuft
i=0
while [ $i -lt 60 ]; do
    pgrep -x gamescope-wl > /dev/null && break
    sleep 1
    i=$((i + 1))
done

while sleep 2; do
    pgrep -x gamescope-wl > /dev/null || break
    [ "$(cat "$STATE" 2>/dev/null)" = "gamemode" ] && continue
    pkill -TERM gamescope-wl
    break
done