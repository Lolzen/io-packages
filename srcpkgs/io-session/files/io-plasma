#!/bin/sh
if pgrep -x kwin_wayland > /dev/null; then
    echo "io: desktop session already running" >&2
    exit 1
fi
export XDG_RUNTIME_DIR=/run/user/$(id -u)
echo desktop > "$XDG_RUNTIME_DIR/io-session-next"
# Valve runs the filter chain as its own PipeWire instance
# (filter-chain.service), with a fixed quantum, locked memory and a single
# malloc arena - settings that would be wrong for the main daemon. prlimit
# raises this process's memlock soft limit to the hard limit io-autologin
# set; MALLOC_ARENA_MAX matches Valve's drop-in.
start_filter_chain() {
    pgrep -f "pipewire -c filter-chain.conf" > /dev/null && return
    # Wait for the main daemon's socket in the background: a PipeWire client
    # started before it exits instead of retrying. Valve gets the ordering
    # from socket activation.
    (
        i=0
        while [ ! -S "$XDG_RUNTIME_DIR/pipewire-0" ] && [ $i -lt 15 ]; do
            sleep 1
            i=$((i + 1))
        done
        MALLOC_ARENA_MAX=1 exec prlimit --memlock=104857600 pipewire -c filter-chain.conf
    ) > /dev/null 2>&1 &
}

# Steam in the desktop draws in real pixels, as on SteamOS: with Steam's
# "scale text and icons to match monitor settings" on, it follows the DPI
# Plasma derives from its 135 % scale and its on-screen keyboard grows wider
# than the screen. The setting is DPIScaling in ~/.steam/registry.vdf
# (HKCU/Software/Valve/Steam); set to 0 once per user, here, while Steam is
# not running (it rewrites the file when it exits). A value the user picks
# later is kept.
steam_dpi_scaling_off() {
    reg="$HOME/.steam/registry.vdf"
    mark="${XDG_CONFIG_HOME:-$HOME/.config}/io-steam-dpi-done"
    [ -e "$mark" ] && return
    [ -f "$reg" ] || return
    if grep -q '"DPIScaling"' "$reg"; then
        sed -i 's/\("DPIScaling"[[:space:]]*\)"1"/\1"0"/' "$reg"
    else
        awk '
            /^\t"HKCU"$/ { hkcu = 1 }
            /^\t"HKLM"$/ { hkcu = 0 }
            { print }
            hkcu && !done && prev ~ /^\t\t\t\t"Steam"$/ && /^\t\t\t\t\{$/ {
                print "\t\t\t\t\t\"DPIScaling\"\t\t\"0\""
                done = 1
            }
            { prev = $0 }
        ' "$reg" > "$reg.io" && mv "$reg.io" "$reg"
    fi
    grep -q '"DPIScaling"[[:space:]]*"0"' "$reg" && touch "$mark"
}

pgrep -x pipewire > /dev/null || pipewire &
start_filter_chain
steam_dpi_scaling_off
exec startplasma-wayland