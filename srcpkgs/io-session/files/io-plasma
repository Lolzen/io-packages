#!/bin/sh
if pgrep -x kwin_wayland > /dev/null; then
    echo "io: desktop session already running" >&2
    exit 1
fi

# Valve runs the filter chain as its own PipeWire instance
# (filter-chain.service), with a fixed quantum, locked memory and a single
# malloc arena - settings that would be wrong for the main daemon. prlimit
# raises this process's memlock soft limit to the hard limit set at login
# (/etc/security/limits.d/90-io-memlock.conf); MALLOC_ARENA_MAX matches Valve's drop-in.
start_filter_chain() {
    pgrep -f "pipewire -c filter-chain.conf" > /dev/null && return
    # Wait for the main daemon's socket in the background: a PipeWire client
    # started before it exits instead of retrying. Valve gets the ordering
    # from socket activation.
    (
        i=0
        while [ ! -S "$XDG_RUNTIME_DIR/pipewire-0" ] && [ $i -lt 15 ]; do
            sleep 1
            i=$((i + 1))
        done
        MALLOC_ARENA_MAX=1 exec prlimit --memlock=104857600 pipewire -c filter-chain.conf
    ) > /dev/null 2>&1 &
}

# Steam in the desktop draws in real pixels, as on SteamOS: with Steam's
# "scale text and icons to match monitor settings" on, it follows the DPI
# Plasma derives from its 135 % scale and its on-screen keyboard grows wider
# than the screen. The setting is DPIScaling in ~/.steam/registry.vdf
# (HKCU/Software/Valve/Steam); set to 0 once per user, here, while Steam is
# not running (it rewrites the file when it exits). A value the user picks
# later is kept.
steam_dpi_scaling_off() {
    reg="$HOME/.steam/registry.vdf"
    mark="${XDG_CONFIG_HOME:-$HOME/.config}/io-steam-dpi-done"
    [ -e "$mark" ] && return
    [ -f "$reg" ] || return
    if grep -q '"DPIScaling"' "$reg"; then
        sed -i 's/\("DPIScaling"[[:space:]]*\)"1"/\1"0"/' "$reg"
    else
        awk '
            /^\t"HKCU"$/ { hkcu = 1 }
            /^\t"HKLM"$/ { hkcu = 0 }
            { print }
            hkcu && !done && prev ~ /^\t\t\t\t"Steam"$/ && /^\t\t\t\t\{$/ {
                print "\t\t\t\t\t\"DPIScaling\"\t\t\"0\""
                done = 1
            }
            { prev = $0 }
        ' "$reg" > "$reg.io" && mv "$reg.io" "$reg"
    fi
    grep -q '"DPIScaling"[[:space:]]*"0"' "$reg" && touch "$mark"
}

# Keep the brightness set in game mode. kwin restores the brightness saved in
# kwinoutputconfig.json when it starts, so the screen jumps to the value from
# the last desktop session. Valve patches kwin for this (0002, "Keep screen
# brightness from gamescope", KDE bug 508163: Workspace::assignBrightnessDevices
# takes the device's observed brightness). Io writes the current backlight
# into the saved value of the internal panel (eDP) instead, in kwin's scale:
# (raw - 1) / (max - 1), as ExternalBrightnessDeviceV1::observedBrightness.
keep_game_mode_brightness() {
    cfg="${XDG_CONFIG_HOME:-$HOME/.config}/kwinoutputconfig.json"
    [ -f "$cfg" ] || return
    for bl in /sys/class/backlight/*; do
        [ -r "$bl/brightness" ] || continue
        python3 - "$cfg" "$(cat "$bl/brightness")" "$(cat "$bl/max_brightness")" << 'EOF' || echo "io: brightness not kept" >&2
import json, os, sys
path, raw, top = sys.argv[1], int(sys.argv[2]), int(sys.argv[3])
if top <= 1:
    sys.exit(0)
value = round(min(max((raw - 1) / (top - 1), 0.0), 1.0), 4)
with open(path) as f:
    config = json.load(f)
changed = False
for part in config:
    if part.get("name") != "outputs":
        continue
    for output in part.get("data", []):
        if str(output.get("connectorName", "")).startswith("eDP"):
            if output.get("brightness") != value:
                output["brightness"] = value
                changed = True
if changed:
    with open(path + ".io", "w") as f:
        json.dump(config, f, indent=4)
    os.replace(path + ".io", path)
EOF
        return
    done
}

pgrep -x pipewire > /dev/null || pipewire &
start_filter_chain
steam_dpi_scaling_off
keep_game_mode_brightness
# HDMI-CEC (SteamOS: cecd.service and cec-audio-control, user services of
# the graphical session). cecd starts through D-Bus activation: anyone asking
# for com.steampowered.CecDaemon1 early (Steam, io-steamos-manager) would
# otherwise have the bus start a second one next to ours. It waits for a CEC
# device to appear (-e); its settings come from io-steamos-manager (HdmiCec1).
busctl --user call org.freedesktop.DBus /org/freedesktop/DBus org.freedesktop.DBus StartServiceByName su com.steampowered.CecDaemon1 0 > /dev/null 2>&1 &
RUST_LOG=info setsid /usr/bin/cec-audio-control -d "" &

exec startplasma-wayland