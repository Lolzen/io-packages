#!/bin/sh
# io-grow-storage - grow the root partition and its filesystem to fill the
# card or disk Io is installed on.
#
# Deliberately never run automatically. A resize at boot would run in runit
# stage 1 before anything else, invisible, and interrupting it can damage
# the filesystem. It is a conscious user step instead:
#   - from Plasma: application menu or desktop icon "Speicherplatz erweitern"
#   - from a terminal or SSH: io-grow-storage
#
# Uses only util-linux (sfdisk, resizepart) and the filesystem's own tool.
# cloud-guest-utils is not needed; it would also bring an automatic
# resize-at-boot core service that Io would then have to disable again.
#
# Safe to run again at any time: when nothing is left to grow it says so and
# changes nothing. If a previous run grew the partition but not the
# filesystem, only the filesystem step is redone.

set -eu

if [ "$(id -u)" -ne 0 ]; then
    exec sudo sh "$0" "$@"
fi

pause() {
    if [ -t 0 ]; then
        printf "\nEnter zum Schliessen..."
        read -r _dummy
    fi
}

fail() {
    echo
    echo "FEHLER: $*" >&2
    pause
    exit 1
}

ask() {
    printf "%s [j/N] " "$1"
    read -r answer
    case "$answer" in
        j|J|y|Y) return 0 ;;
        *) echo "Abgebrochen."; pause; exit 0 ;;
    esac
}

gib() {
    awk -v b="$1" 'BEGIN { printf "%.1f GiB", b / 1073741824 }'
}

ROOT_SRC=$(findmnt -n -o SOURCE /)
ROOT_FS=$(findmnt -n -o FSTYPE /)
ROOT_NAME=${ROOT_SRC##*/}
DISK=$(lsblk -no PKNAME "$ROOT_SRC")
[ -n "$DISK" ] || fail "Datentraeger von $ROOT_SRC nicht gefunden."
PART=$(cat "/sys/class/block/$ROOT_NAME/partition")
SYSPART=/sys/class/block/$ROOT_NAME

# All sizes in 512-byte sectors, as the kernel reports them in sysfs.
disk_sectors() { cat "/sys/block/$DISK/size"; }
part_start() { cat "$SYSPART/start"; }
part_sectors() { cat "$SYSPART/size"; }
fs_bytes() { df -B1 --output=size / | tail -1 | tr -d ' '; }

# Root must be the last partition, otherwise there is nothing behind it.
for p in /sys/block/"$DISK"/"$DISK"*; do
    [ -r "$p/start" ] || continue
    if [ "$(cat "$p/start")" -gt "$(part_start)" ]; then
        fail "Hinter der Root-Partition liegt ${p##*/}; Io kann nicht erweitern."
    fi
done

# GPT keeps 33 sectors for its backup copy at the very end of the disk.
GROWABLE=$(( ($(disk_sectors) - 34 - $(part_start) - $(part_sectors)) * 512 ))
FS_GAP=$(( $(part_sectors) * 512 - $(fs_bytes) ))
MIN=104857600

grow_fs() {
    echo "Vergroessere Dateisystem ($ROOT_FS). Bitte nicht ausschalten..."
    case "$ROOT_FS" in
        ext2|ext3|ext4) resize2fs "$ROOT_SRC" ;;
        btrfs) btrfs filesystem resize max / ;;
        xfs) xfs_growfs / ;;
        *) fail "Dateisystem $ROOT_FS kann im laufenden Betrieb nicht vergroessert werden." ;;
    esac
    sync
}

echo "=========================================="
echo " Io - Speicherplatz erweitern"
echo "=========================================="
echo
echo "Datentraeger:  /dev/$DISK ($(gib $(( $(disk_sectors) * 512 ))))"
echo "Root:          $ROOT_SRC, Partition $PART, $ROOT_FS"
echo "Partition:     $(gib $(( $(part_sectors) * 512 )))"
echo "Dateisystem:   $(gib "$(fs_bytes)"), frei: $(df -h --output=avail / | tail -1 | tr -d ' ')"
echo
lsblk "/dev/$DISK"
echo

if [ "$GROWABLE" -lt "$MIN" ]; then
    if [ "$FS_GAP" -gt "$MIN" ]; then
        echo "Die Partition ist bereits voll, das Dateisystem aber noch nicht."
        ask "Dateisystem jetzt auf die volle Partition erweitern?"
        grow_fs
    else
        echo "Es gibt nichts zu erweitern: Partition und Dateisystem"
        echo "nutzen den verfuegbaren Platz bereits vollstaendig."
    fi
    echo
    df -h /
    pause
    exit 0
fi

echo "Die Root-Partition kann um $(gib "$GROWABLE") wachsen."
echo "Startsektor, UUID und Name der Partition bleiben unveraendert."
echo
ask "Root-Partition jetzt auf volle Groesse erweitern?"

echo
echo "Erweitere Partition. Bitte nicht ausschalten..."
# An image written to a larger card still has its GPT backup where the old
# end was; move it to the real end first, then grow the partition into the
# freed space. --no-reread: the disk is in use, the kernel is told below.
sfdisk -q --no-reread --relocate gpt-bak-std "/dev/$DISK" > /dev/null 2>&1 || true
echo ", +" | sfdisk -q -N "$PART" --no-reread "/dev/$DISK" || fail "sfdisk konnte die Partition nicht erweitern."

NEW=$(sfdisk -q -l -o Device,Sectors "/dev/$DISK" | awk -v d="$ROOT_SRC" '$1 == d { print $2 }')
[ -n "$NEW" ] || fail "Neue Partitionsgroesse nicht lesbar."
resizepart "/dev/$DISK" "$PART" "$NEW" 2> /dev/null || true
sleep 1

if [ "$(part_sectors)" -ne "$NEW" ]; then
    echo
    echo "Die Partitionstabelle ist geaendert, der Kernel sieht die neue"
    echo "Groesse aber erst nach einem Neustart. Bitte neu starten und"
    echo "io-grow-storage danach noch einmal ausfuehren - es erweitert dann"
    echo "nur noch das Dateisystem."
    pause
    exit 0
fi

grow_fs
echo "Fertig."
echo
df -h /
pause
