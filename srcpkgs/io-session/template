# Template file for 'io-session'
pkgname=io-session
version=0.2.0
revision=8
optdepends="kde-plasma: Desktop-Session ueber steamos-session-select plasma"
conf_files="/etc/sv/io-autologin/conf"
depends="gamescope steam pipewire wireplumber dbus steamos-powerbuttond io-volumed io-steamos-manager"
short_desc="Io game mode session scripts and session switching"
maintainer="Georg <funer@gmx.at>"
license="MIT"
homepage="https://github.com/Lolzen/io-packages"

post_install() {
	mkdir -p /etc/pipewire/pipewire.conf.d
	WP_CONF=$(find /usr/share/examples/wireplumber -maxdepth 1 -name "*.conf" 2>/dev/null | head -1)
	PW_PULSE_CONF=$(find /usr/share/examples/pipewire -maxdepth 1 -name "*.conf" 2>/dev/null | head -1)
	if [ -n "$WP_CONF" ]; then
		ln -sf "$WP_CONF" /etc/pipewire/pipewire.conf.d/
	fi
	if [ -n "$PW_PULSE_CONF" ]; then
		ln -sf "$PW_PULSE_CONF" /etc/pipewire/pipewire.conf.d/
	fi
}

do_build() {
	:
}

do_install() {
	vbin ${FILESDIR}/io-gamemode
	vbin ${FILESDIR}/io-start
	vmkdir etc/sv/io-autologin
	vinstall ${FILESDIR}/sv-autologin/run 755 etc/sv/io-autologin run
	vinstall ${FILESDIR}/sv-autologin/conf 644 etc/sv/io-autologin conf
	vmkdir etc/skel
	vbin ${FILESDIR}/io-plasma
	vbin ${FILESDIR}/steamos-session-select
	vmkdir etc/skel/Desktop
	vinstall ${FILESDIR}/return-to-gamemode.desktop 755 etc/skel/Desktop
	vmkdir etc/profile.d
	vinstall ${FILESDIR}/io-session.sh 755 etc/profile.d
}