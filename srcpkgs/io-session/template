# Template file for 'io-session'
pkgname=io-session
version=0.3.0
revision=13
optdepends="kde-plasma: desktop session via steamos-session-select plasma"
conf_files="/etc/sv/io-autologin/conf"
depends="gamescope steam pipewire wireplumber dbus steamos-powerbuttond io-volumed io-steamos-manager rtkit libcap-progs"
short_desc="Io game mode session scripts and session switching"
maintainer="Georg <funer@gmx.at>"
license="MIT"
homepage="https://github.com/Lolzen/io-packages"

do_build() {
	:
}

do_install() {
	vbin ${FILESDIR}/io-gamemode
	vbin ${FILESDIR}/io-start
	vmkdir etc/sv/io-autologin
	vinstall ${FILESDIR}/sv-autologin/run 755 etc/sv/io-autologin run
	vinstall ${FILESDIR}/sv-autologin/conf 644 etc/sv/io-autologin conf
	vmkdir etc/skel
	vbin ${FILESDIR}/io-plasma
	vbin ${FILESDIR}/steamos-session-select
	vmkdir etc/skel/Desktop
	vinstall ${FILESDIR}/return-to-gamemode.desktop 755 etc/skel/Desktop
	vbin ${FILESDIR}/io-grow-storage
	vinstall ${FILESDIR}/io-grow-storage.desktop 644 usr/share/applications
	vinstall ${FILESDIR}/io-grow-storage.desktop 644 etc/skel/Desktop
	vmkdir etc/profile.d
	# zz-: /etc/profile sources profile.d in name order, and this one starts
	# the session, so every other profile script (locale.sh sets LANG) must
	# have run before it.
	vinstall ${FILESDIR}/io-session.sh 755 etc/profile.d zz-io-session.sh

	vmkdir etc/pipewire/pipewire.conf.d
	ln -sf /usr/share/examples/wireplumber/10-wireplumber.conf "${DESTDIR}/etc/pipewire/pipewire.conf.d/10-wireplumber.conf"
	ln -sf /usr/share/examples/pipewire/20-pipewire-pulse.conf "${DESTDIR}/etc/pipewire/pipewire.conf.d/20-pipewire-pulse.conf"

	vmkdir etc/runit/core-services
	vinstall ${FILESDIR}/90-io-gamescope-caps.sh 644 etc/runit/core-services

	vbin ${FILESDIR}/io-devmode
	vbin ${FILESDIR}/io-netcheck
}