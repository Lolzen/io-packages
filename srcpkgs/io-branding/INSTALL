# Make Io's splash the default Plymouth theme. plymouth-set-default-theme
# is Plymouth's own interface for this; it edits the user-owned
# /etc/plymouth/plymouthd.conf. The initramfs must be rebuilt afterwards to
# carry the theme (mkimg.sh does that as its last step). Only on the first
# install: an update must not undo a theme the user picked since.
case "${ACTION}" in
post)
	if [ "${UPDATE}" = "no" ] && [ -x usr/bin/plymouth-set-default-theme ]; then
		usr/bin/plymouth-set-default-theme io || :
	fi
	;;
esac
