#!/bin/sh
# io-repair - "Repair Io" on the recovery desktop. A placeholder for repair
# tools to come; for now it lists the disks. The window stays open
# (konsole --hold), so no key press is needed.
set -eu
printf 'Io repair tools are not implemented yet.\n\n'
printf 'Block devices:\n\n'
lsblk -o NAME,SIZE,FSTYPE,LABEL,MOUNTPOINTS,MODEL,TRAN
