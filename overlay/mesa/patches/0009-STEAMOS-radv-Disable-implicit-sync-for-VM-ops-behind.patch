From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Natalie Vock <nat@pixelcluster.dev>
Date: Sat, 17 Oct 2026 14:38:31 +0200
Subject: [PATCH 09/17] STEAMOS: radv: Disable implicit sync for VM ops behind
 a  driconf

radv_vm_explicit_sync=true can be used to enable this path.

Io: ported to Mesa 26.2.5, where RADV's driconf options are declared in
radv_drirc_gen.py and the winsys is created per device in radv_device.c.

(cherry picked from commit 8be8ceba5fd8b4dde3d0547eda250e2480c1bc38)
---
 src/amd/vulkan/radv_device.c                             | 2 +-
 src/amd/vulkan/radv_drirc_gen.py                         | 3 +++
 src/amd/vulkan/radv_queue.c                              | 3 ++-
 src/amd/vulkan/winsys/amdgpu/radv_amdgpu_bo.c            | 4 ++--
 src/amd/vulkan/winsys/amdgpu/radv_amdgpu_winsys.c        | 3 ++-
 src/amd/vulkan/winsys/amdgpu/radv_amdgpu_winsys.h        | 1 +
 src/amd/vulkan/winsys/amdgpu/radv_amdgpu_winsys_public.h | 3 ++-
 7 files changed, 13 insertions(+), 6 deletions(-)

diff --git a/src/amd/vulkan/radv_device.c b/src/amd/vulkan/radv_device.c
index 6bfb0ba5d44..7a83a70eb3c 100644
--- a/src/amd/vulkan/radv_device.c
+++ b/src/amd/vulkan/radv_device.c
@@ -1345,7 +1345,7 @@ radv_create_winsys(struct radv_device *device)
       pdev->drm_device_type == RADV_DRM_DEVICE_AMDGPU_VPIPE || pdev->drm_device_type == RADV_DRM_DEVICE_VIRTIO;
 
    result = radv_amdgpu_winsys_create(fd, &pdev->info, instance->debug_flags, instance->perftest_flags, is_virtio,
-                                      &device->ws);
+                                      instance->drirc.features.vm_explicit_sync, &device->ws);
 
    if (fd != -1)
       close(fd);
diff --git a/src/amd/vulkan/radv_drirc_gen.py b/src/amd/vulkan/radv_drirc_gen.py
index 111b93caa3a..a2d96837ff9 100644
--- a/src/amd/vulkan/radv_drirc_gen.py
+++ b/src/amd/vulkan/radv_drirc_gen.py
@@ -129,6 +129,9 @@ def declare_options():
         B("radv_enable_float16_gfx8", False,
           "Expose float16 on GFX8, where it's supported but usually not beneficial.",
           c_name="enable_float16_gfx8"),
+        B("radv_vm_explicit_sync", False,
+          "Use explicit synchronization for VM ops if the kernel supports it.",
+          c_name="vm_explicit_sync"),
     ]
 
     misc_options = [
diff --git a/src/amd/vulkan/radv_queue.c b/src/amd/vulkan/radv_queue.c
index b1ad0772e4c..a0478c0438d 100644
--- a/src/amd/vulkan/radv_queue.c
+++ b/src/amd/vulkan/radv_queue.c
@@ -1117,7 +1117,8 @@ radv_update_preamble_cs(struct radv_queue_state *queue_state, struct radv_queue
        compute_scratch_bo != queue_state->compute_scratch_bo || esgs_ring_bo != queue_state->esgs_ring_bo ||
        gsvs_ring_bo != queue_state->gsvs_ring_bo || descriptor_bo != queue_state->descriptor_bo) {
 
-      if (radv_device_physical(device)->info.has_explicit_sync_vm_ops) {
+      if (radv_device_physical(device)->info.has_explicit_sync_vm_ops &&
+          radv_physical_device_instance(radv_device_physical(device))->drirc.features.vm_explicit_sync) {
          bool success =
             device->ws->ctx_wait_idle(queue->hw_ctx, radv_queue_ring(queue), queue->vk.index_in_family);
          if (!success) {
diff --git a/src/amd/vulkan/winsys/amdgpu/radv_amdgpu_bo.c b/src/amd/vulkan/winsys/amdgpu/radv_amdgpu_bo.c
index 8b314216584..3a61e04bffd 100644
--- a/src/amd/vulkan/winsys/amdgpu/radv_amdgpu_bo.c
+++ b/src/amd/vulkan/winsys/amdgpu/radv_amdgpu_bo.c
@@ -45,7 +45,7 @@ radv_amdgpu_bo_va_op(struct radv_amdgpu_winsys *ws, uint32_t bo_handle, uint64_t
    if (!wait_syncobj)
       return -ENOMEM;
 
-   if (ws->info.has_explicit_sync_vm_ops) {
+   if (ws->info.has_explicit_sync_vm_ops && ws->vm_explicit_sync) {
       for (uint32_t i = 0; i < wait_count; ++i) {
          if (waits[i].sync->type == &vk_sync_dummy_type)
             continue;
@@ -95,7 +95,7 @@ radv_amdgpu_bo_va_op(struct radv_amdgpu_winsys *ws, uint32_t bo_handle, uint64_t
       r = ac_drm_cs_syncobj_timeline_wait(ws->dev, &ws->vm_timeline_syncobj, &vm_timeline_point, 1, INT64_MAX,
                                           DRM_SYNCOBJ_WAIT_FLAGS_WAIT_ALL | DRM_SYNCOBJ_WAIT_FLAGS_WAIT_FOR_SUBMIT,
                                           NULL);
-   } else if (ws->info.has_explicit_sync_vm_ops) {
+   } else if (ws->info.has_explicit_sync_vm_ops && ws->vm_explicit_sync) {
       flags |= AMDGPU_VM_EXPLICIT_SYNC;
       r = ac_drm_bo_va_op_raw2(ws->dev, bo_handle, offset, size, addr, flags, ops, 0, 0, (uint64_t)wait_syncobj,
                                wait_idx);
diff --git a/src/amd/vulkan/winsys/amdgpu/radv_amdgpu_winsys.c b/src/amd/vulkan/winsys/amdgpu/radv_amdgpu_winsys.c
index c47d4214565..0472c82c9d2 100644
--- a/src/amd/vulkan/winsys/amdgpu/radv_amdgpu_winsys.c
+++ b/src/amd/vulkan/winsys/amdgpu/radv_amdgpu_winsys.c
@@ -220,7 +220,7 @@ radv_amdgpu_winsys_unreserve_vmid(struct radeon_winsys *rws)
 
 VkResult
 radv_amdgpu_winsys_create(int fd, const struct radeon_info *info, uint64_t debug_flags, uint64_t perftest_flags,
-                          bool is_virtio, struct radeon_winsys **winsys)
+                          bool is_virtio, bool vm_explicit_sync, struct radeon_winsys **winsys)
 {
    VkResult result = VK_SUCCESS;
 
@@ -270,6 +270,7 @@ radv_amdgpu_winsys_create(int fd, const struct radeon_info *info, uint64_t debug
    ws->perftest = perftest_flags;
    ws->zero_all_vram_allocs = debug_flags & RADV_DEBUG_ZERO_VRAM;
    ws->debug_vm = debug_flags & RADV_DEBUG_VM;
+   ws->vm_explicit_sync = vm_explicit_sync;
    u_rwlock_init(&ws->global_bo_list.lock);
    list_inithead(&ws->log_bo_list);
    u_rwlock_init(&ws->log_bo_list_lock);
diff --git a/src/amd/vulkan/winsys/amdgpu/radv_amdgpu_winsys.h b/src/amd/vulkan/winsys/amdgpu/radv_amdgpu_winsys.h
index 2ddf0fe5978..6d0e284f858 100644
--- a/src/amd/vulkan/winsys/amdgpu/radv_amdgpu_winsys.h
+++ b/src/amd/vulkan/winsys/amdgpu/radv_amdgpu_winsys.h
@@ -51,6 +51,7 @@ struct radv_amdgpu_winsys {
    bool chain_ib;
    bool zero_all_vram_allocs;
    bool debug_vm;
+   bool vm_explicit_sync;
    uint64_t perftest;
 
    struct radv_amdgpu_alloc_tracker *alloc_tracker;
diff --git a/src/amd/vulkan/winsys/amdgpu/radv_amdgpu_winsys_public.h b/src/amd/vulkan/winsys/amdgpu/radv_amdgpu_winsys_public.h
index cc3a484d291..ace4f383e20 100644
--- a/src/amd/vulkan/winsys/amdgpu/radv_amdgpu_winsys_public.h
+++ b/src/amd/vulkan/winsys/amdgpu/radv_amdgpu_winsys_public.h
@@ -18,7 +18,8 @@
 #include "vk_sync.h"
 
 VkResult radv_amdgpu_winsys_create(int fd, const struct radeon_info *info, uint64_t debug_flags,
-                                   uint64_t perftest_flags, bool is_virtio, struct radeon_winsys **winsys);
+                                   uint64_t perftest_flags, bool is_virtio, bool vm_explicit_sync,
+                                   struct radeon_winsys **winsys);
 
 struct radeon_winsys_info {
    struct radeon_info base;
