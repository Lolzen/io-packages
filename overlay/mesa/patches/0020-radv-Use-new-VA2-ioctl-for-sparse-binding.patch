From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Natalie Vock <nat@pixelcluster.dev>
Date: Mon, 16 Nov 2026 17:21:28 +0100
Subject: [PATCH 20/20] radv: Use new VA2 ioctl for sparse binding

---
 src/amd/vulkan/radv_buffer.c | 16 +++++++++++----
 src/amd/vulkan/radv_queue.c  | 40 ++++++++++++++++++++++--------------
 2 files changed, 37 insertions(+), 19 deletions(-)

diff --git a/src/amd/vulkan/radv_buffer.c b/src/amd/vulkan/radv_buffer.c
index d1a62f634c0..ca099215113 100644
--- a/src/amd/vulkan/radv_buffer.c
+++ b/src/amd/vulkan/radv_buffer.c
@@ -320,11 +320,19 @@ radv_bo_virtual_bind(struct radv_device *device, uint32_t bind_count,
    struct radeon_winsys *ws = device->ws;
    VkResult result;
 
-   for (uint32_t i = 0; i < bind_count; ++i) {
-      result = ws->buffer_virtual_bind(ws, bind_infos[i].parent, bind_infos[i].offset, bind_infos[i].size,
-                                       bind_infos[i].bo, bind_infos[i].bo_offset, wait_count, waits);
+   if (pdev->info.has_explicit_sync_vm_ops) {
+      result = ws->buffer_virtual_bind_many(ws, bind_count, bind_infos, wait_count, waits, signal_count, signals);
       if (result != VK_SUCCESS)
-         return i ? vk_device_set_lost(&device->vk, "Sparse binding operation partially failed") : result;
+         return result;
+   }
+
+   for (uint32_t i = 0; i < bind_count; ++i) {
+      if (!pdev->info.has_explicit_sync_vm_ops) {
+         result = ws->buffer_virtual_bind(ws, bind_infos[i].parent, bind_infos[i].offset, bind_infos[i].size,
+                                          bind_infos[i].bo, bind_infos[i].bo_offset, wait_count, waits);
+         if (result != VK_SUCCESS)
+            return i ? vk_device_set_lost(&device->vk, "Sparse binding operation partially failed") : result;
+      }
 
       if (bind_infos[i].bo)
          radv_rmv_log_sparse_add_residency(device, bind_infos[i].parent, bind_infos[i].offset);
diff --git a/src/amd/vulkan/radv_queue.c b/src/amd/vulkan/radv_queue.c
index 2a084b93c4a..4c451c4a7dc 100644
--- a/src/amd/vulkan/radv_queue.c
+++ b/src/amd/vulkan/radv_queue.c
@@ -121,7 +121,6 @@ radv_sparse_image_bind_memory(struct radv_device *device, const VkSparseImageMem
    const struct radv_physical_device *pdev = radv_device_physical(device);
    const struct radeon_surf *surface = &image->planes[0].surface;
    uint32_t bs = vk_format_get_blocksize(image->vk.format);
-   VkResult result;
 
    for (uint32_t i = 0; i < bind->bindCount; ++i) {
       struct radv_device_memory *mem = NULL;
@@ -1858,25 +1857,28 @@ radv_queue_sparse_submit(struct vk_queue *vqueue, struct vk_queue_submit *submis
 {
    struct radv_queue *queue = (struct radv_queue *)vqueue;
    struct radv_device *device = radv_queue_device(queue);
+   const struct radv_physical_device *pdev = radv_device_physical(device);
    VkResult result;
 
    result = radv_queue_submit_bind_sparse_memory(device, submission);
    if (result != VK_SUCCESS)
       goto fail;
 
-   /* We do a CPU wait here, in part to avoid more winsys mechanisms. In the likely kernel explicit
-    * sync mechanism, we'd need to do a CPU wait anyway. Haven't seen this be a perf issue yet, but
-    * we have to make sure the queue always has its submission thread enabled. */
-   result = vk_sync_wait_many(&device->vk, submission->wait_count, submission->waits, 0, UINT64_MAX);
-   if (result != VK_SUCCESS)
-      goto fail;
-
-   /* Ignore all the commandbuffers. They're necessarily empty anyway. */
-
-   for (unsigned i = 0; i < submission->signal_count; ++i) {
-      result = vk_sync_signal(&device->vk, submission->signals[i].sync, submission->signals[i].signal_value);
+   if (!pdev->info.has_explicit_sync_vm_ops) {
+      /* We do a CPU wait here, in part to avoid more winsys mechanisms. In the likely kernel explicit
+       * sync mechanism, we'd need to do a CPU wait anyway. Haven't seen this be a perf issue yet, but
+       * we have to make sure the queue always has its submission thread enabled. */
+      result = vk_sync_wait_many(&device->vk, submission->wait_count, submission->waits, 0, UINT64_MAX);
       if (result != VK_SUCCESS)
          goto fail;
+
+      /* Ignore all the commandbuffers. They're necessarily empty anyway. */
+
+      for (unsigned i = 0; i < submission->signal_count; ++i) {
+         result = vk_sync_signal(&device->vk, submission->signals[i].sync, submission->signals[i].signal_value);
+         if (result != VK_SUCCESS)
+            goto fail;
+      }
    }
 
 fail:
@@ -1899,10 +1901,18 @@ radv_queue_submit(struct vk_queue *vqueue, struct vk_queue_submit *submission)
 {
    struct radv_queue *queue = (struct radv_queue *)vqueue;
    struct radv_device *device = radv_queue_device(queue);
+   const struct radv_physical_device *pdev = radv_device_physical(device);
+   VkResult result;
 
-   VkResult result = radv_queue_submit_bind_sparse_memory(device, submission);
-   if (result != VK_SUCCESS)
-      goto fail;
+   if (submission->buffer_bind_count || submission->image_bind_count || submission->image_opaque_bind_count) {
+      result = radv_queue_submit_bind_sparse_memory(device, submission);
+      if (result != VK_SUCCESS)
+         goto fail;
+
+      assert(!submission->command_buffer_count);
+      if (pdev->info.has_explicit_sync_vm_ops)
+         return VK_SUCCESS;
+   }
 
    if (!submission->command_buffer_count && !submission->wait_count && !submission->signal_count)
       return VK_SUCCESS;
-- 
2.43.0

