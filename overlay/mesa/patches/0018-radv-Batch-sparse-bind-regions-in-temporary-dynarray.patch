-                              struct radeon_winsys_bo *bo, uint64_t bo_offset, uint32_t wait_count,
-                              const struct vk_sync_wait *waits);
+VkResult radv_bo_virtual_bind(struct radv_device *device, uint32_t bind_count,
+                              struct radv_winsys_virtual_bind_info *bind_infos, uint32_t wait_count,
+                              const struct vk_sync_wait *waits, uint32_t signal_count,
+                              const struct vk_sync_signal *signals);
 
 void radv_bo_destroy(struct radv_device *device, struct vk_object_base *object, struct radeon_winsys_bo *bo);
 
diff --git a/src/amd/vulkan/radv_queue.c b/src/amd/vulkan/radv_queue.c
