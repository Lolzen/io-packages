       const uint64_t low_va = radv_amdgpu_virtual_bo_get_low_addr(ws, parent);
 
       r = radv_amdgpu_bo_va_op(ws, bo->bo_handle, bo_offset, size, low_va + offset, bo->flags & RADEON_FLAG_GL2_BYPASS,
-                               0, AMDGPU_VA_OP_REPLACE);
