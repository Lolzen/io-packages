From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Tatsuyuki Ishi <ishitatsuyuki@gmail.com>
Date: Tue, 22 Aug 2023 22:05:49 +0900
Subject: [PATCH 08/17] STEAMOS: radv: Disable implicit sync for VM ops.

(cherry picked from commit ee216df60e878608ea8755d6093abf3fcf0662fc)

Io: rebased onto Mesa 26.2.5 (the calls of radv_amdgpu_bo_va_op that
upstream changed since Valve's base get the two new arguments; the
assert uses vk_sync_type_is_drm_syncobj(), as the winsys no longer
holds the sync type).
---
 src/amd/vulkan/radv_buffer.c                  |  2 +-
 src/amd/vulkan/radv_radeon_winsys.h           |  3 +-
 src/amd/vulkan/winsys/amdgpu/radv_amdgpu_bo.c | 70 +++++++++++++------
 3 files changed, 53 insertions(+), 22 deletions(-)

diff --git a/src/amd/vulkan/radv_buffer.c b/src/amd/vulkan/radv_buffer.c
index 651dae21acc..35dc39c90b9 100644
--- a/src/amd/vulkan/radv_buffer.c
+++ b/src/amd/vulkan/radv_buffer.c
@@ -316,7 +316,7 @@ radv_bo_virtual_bind(struct radv_device *device, struct vk_object_base *object,
    struct radeon_winsys *ws = device->ws;
    VkResult result;
 
-   result = ws->buffer_virtual_bind(ws, parent, offset, size, bo, bo_offset);
+   result = ws->buffer_virtual_bind(ws, parent, offset, size, bo, bo_offset, wait_count, waits);
    if (result != VK_SUCCESS)
       return result;
 
diff --git a/src/amd/vulkan/radv_radeon_winsys.h b/src/amd/vulkan/radv_radeon_winsys.h
index 632f8c96893..6bdda446c68 100644
--- a/src/amd/vulkan/radv_radeon_winsys.h
+++ b/src/amd/vulkan/radv_radeon_winsys.h
@@ -258,7 +258,8 @@ struct radeon_winsys {
    void (*buffer_get_metadata)(struct radeon_winsys *ws, struct radeon_winsys_bo *bo, struct radeon_bo_metadata *md);
 
    VkResult (*buffer_virtual_bind)(struct radeon_winsys *ws, struct radeon_winsys_bo *parent, uint64_t offset,
-                                   uint64_t size, struct radeon_winsys_bo *bo, uint64_t bo_offset);
+                                   uint64_t size, struct radeon_winsys_bo *bo, uint64_t bo_offset, uint32_t wait_count,
+                                   const struct vk_sync_wait *waits);
 
    VkResult (*buffer_make_resident)(struct radeon_winsys *ws, struct radeon_winsys_bo *bo, bool resident);
 
diff --git a/src/amd/vulkan/winsys/amdgpu/radv_amdgpu_bo.c b/src/amd/vulkan/winsys/amdgpu/radv_amdgpu_bo.c
index a4cf1332bc0..8b314216584 100644
--- a/src/amd/vulkan/winsys/amdgpu/radv_amdgpu_bo.c
+++ b/src/amd/vulkan/winsys/amdgpu/radv_amdgpu_bo.c
@@ -28,12 +28,34 @@
 #include "util/u_math.h"
 #include "util/u_memory.h"
 
+#include "vk_drm_syncobj.h"
+#include "vk_sync_dummy.h"
+
 static void radv_amdgpu_winsys_bo_destroy(struct radeon_winsys *_ws, struct radeon_winsys_bo *_bo);
 
 static int
 radv_amdgpu_bo_va_op(struct radv_amdgpu_winsys *ws, uint32_t bo_handle, uint64_t offset, uint64_t size, uint64_t addr,
-                     uint32_t bo_flags, uint64_t internal_flags, uint32_t ops)
+                     uint32_t bo_flags, uint64_t internal_flags, uint32_t ops, uint32_t wait_count,
+                     const struct vk_sync_wait *waits)
 {
+   uint64_t wait_idx = 0;
+
+   STACK_ARRAY(uint32_t, wait_syncobj, wait_count);
+
+   if (!wait_syncobj)
+      return -ENOMEM;
+
+   if (ws->info.has_explicit_sync_vm_ops) {
+      for (uint32_t i = 0; i < wait_count; ++i) {
+         if (waits[i].sync->type == &vk_sync_dummy_type)
+            continue;
+
+         assert(vk_sync_type_is_drm_syncobj(waits[i].sync->type));
+         wait_syncobj[wait_idx] = ((struct vk_drm_syncobj *)waits[i].sync)->syncobj;
+         ++wait_idx;
+      }
+   }
+
    uint64_t flags = internal_flags;
    int r;
 
@@ -68,15 +90,21 @@ radv_amdgpu_bo_va_op(struct radv_amdgpu_winsys *ws, uint32_t bo_handle, uint64_t
       simple_mtx_unlock(&ws->vm_ioctl_lock);
 
       if (r)
-         return r;
+         goto out;
 
       r = ac_drm_cs_syncobj_timeline_wait(ws->dev, &ws->vm_timeline_syncobj, &vm_timeline_point, 1, INT64_MAX,
                                           DRM_SYNCOBJ_WAIT_FLAGS_WAIT_ALL | DRM_SYNCOBJ_WAIT_FLAGS_WAIT_FOR_SUBMIT,
                                           NULL);
+   } else if (ws->info.has_explicit_sync_vm_ops) {
+      flags |= AMDGPU_VM_EXPLICIT_SYNC;
+      r = ac_drm_bo_va_op_raw2(ws->dev, bo_handle, offset, size, addr, flags, ops, 0, 0, (uint64_t)wait_syncobj,
+                               wait_idx);
    } else {
       r = ac_drm_bo_va_op_raw(ws->dev, bo_handle, offset, size, addr, flags, ops);
    }
 
+out:
+   STACK_ARRAY_FINISH(wait_syncobj);
    return r;
 }
 
@@ -154,7 +182,7 @@ radv_amdgpu_virtual_bo_bind_low_null_prt(struct radv_amdgpu_winsys *ws, struct r
       int r;
 
       r = radv_amdgpu_bo_va_op(ws, radv_amdgpu_winsys_bo(ws->null_prt_bug.bo)->bo_handle, 0, chunk_size,
