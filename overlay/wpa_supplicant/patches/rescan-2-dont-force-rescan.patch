From ab3200b10628bbae50abb56edb7c48334452d6e5 Mon Sep 17 00:00:00 2001
From: Vignesh Raman <vignesh.raman@collabora.com>
Date: Fri, 14 Aug 2026 14:02:51 +0530
Subject: [PATCH] wpa_supplicant: Don't force rescan for restricted scans

The 6 GHz coverage check forces a rescan whenever a scan doesn't cover 6
GHz, even when the scan was deliberately restricted to one channel. This
reintroduced a redundant rescan.

Skip forcing the rescan when the last scan was explicitly restricted.

Signed-off-by: Vignesh Raman <vignesh.raman@collabora.com>
---
 wpa_supplicant/events.c           | 12 +++++++++---
 wpa_supplicant/wpa_supplicant_i.h |  1 +
 2 files changed, 10 insertions(+), 3 deletions(-)

diff --git a/wpa_supplicant/events.c b/wpa_supplicant/events.c
index 116b5688c..b2d9558aa 100644
--- a/wpa_supplicant/events.c
+++ b/wpa_supplicant/events.c
@@ -6123,9 +6123,13 @@ void wpa_supplicant_update_channel_list(struct wpa_supplicant *wpa_s,
 			wpa_dbg(ifs, MSG_INFO,
 				"Channel list changed: 6 GHz was enabled");
 
-			/* Only force a rescan if the 6 GHz band has not been
-			 * scanned yet. */
-			if (!ifs->last_scan_covered_6ghz)
+			/*
+			 * Only force a rescan if the 6 GHz band has not been
+			 * scanned yet, and the last scan was not explicitly
+			 * restricted to specific channels by the caller.
+			 */
+			if (!ifs->last_scan_covered_6ghz &&
+			    !ifs->last_scan_was_restricted)
 				ifs->crossed_6ghz_dom = true;
 		}
 	}
@@ -7028,6 +7032,8 @@ static void wpas_check_last_scan_6ghz(struct wpa_supplicant *wpa_s,
 	if (info->external_scan)
 		return;
 
+	wpa_s->last_scan_was_restricted = !wpa_s->last_scan_all_chan;
+
 	wpa_s->last_scan_covered_6ghz = false;
 	if (!info->freqs)
 		return;
diff --git a/wpa_supplicant/wpa_supplicant_i.h b/wpa_supplicant/wpa_supplicant_i.h
index 3e2c7b588..4f30cff1c 100644
--- a/wpa_supplicant/wpa_supplicant_i.h
+++ b/wpa_supplicant/wpa_supplicant_i.h
@@ -1730,6 +1730,7 @@ struct wpa_supplicant {
 	bool is_6ghz_enabled;
 	bool crossed_6ghz_dom;
 	bool last_scan_covered_6ghz;
+	bool last_scan_was_restricted;
 	bool last_scan_all_chan;
 	bool last_scan_non_coloc_6ghz;
 	bool support_6ghz;
-- 
